}, {
  "@id" : "http://xmlns.com/foaf/0.1/homepage",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "http://xmlns.com/foaf/0.1/logo",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "https://w3id.org/optimar",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/abstract" : [ {
    "@language" : "en",
    "@value" : "Ontology modelling structural elements, mooring systems, sensors, events, and failures in floating offshore wind platforms, including measurement data, involved actors, and semantic relationships between components. It reuses SOSA/SSN for observations, PROV-O for event and data provenance, and QUDT for quantities and units."
  }, {
    "@language" : "es",
    "@value" : "Ontología que modela los elementos estructurales, sistemas de amarre, sensores, eventos y fallos de plataformas eólicas offshore flotantes, incluyendo datos de medición, actores involucrados y relaciones semánticas entre componentes. Reutiliza SOSA/SSN para observaciones, PROV-O para la procedencia de eventos y datos y QUDT para cantidades y unidades."
  } ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@language" : "en",
    "@value" : "Flores, A., Garcia, O., & Aceta, C. (2026). Offshore Wind Power Platform Ontology for OPTiMAR (v2.4). DOI: 10.5281/zenodo.17962874"
  }, {
    "@language" : "es",
    "@value" : "Flores, A., Garcia, O., & Aceta, C. (2026). Ontología de Plataforma Eólica Offshore para OPTiMAR (v2.4). DOI: 10.5281/zenodo.17962874"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2025-09-30"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Alejandro Flores (USAL)"
  }, {
    "@value" : "Cristina Aceta (Tekniker)"
  }, {
    "@value" : "Oihana Garcia (Tekniker)"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "es",
    "@value" : "Esta ontología describe los componentes, fallos, sensores y eventos relacionados con las plataformas eólicas offshore flotantes."
  }, {
    "@language" : "en",
    "@value" : "This ontology describes the components, failures, sensors, and events related to floating offshore wind platforms."
  } ],
  "http://purl.org/dc/terms/identifier" : [ {
    "@id" : "https://doi.org/10.5281/zenodo.17962874"
  } ],
  "http://purl.org/dc/terms/issued" : [ {
