###  https://w3id.org/optimar#WindFarm
:WindFarm rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :hasPlatform ;
                            owl:someValuesFrom :WindPowerPlatform
                          ] ;
          rdfs:comment "An offshore wind farm composed of one or more wind power platforms."@en ,
                       "Un parque eólico offshore compuesto por una o más plataformas eólicas."@es ;
          rdfs:label "Parque eólico"@es ,
                     "Wind Farm"@en .


###  https://w3id.org/optimar#WindPowerPlatform
:WindPowerPlatform rdf:type owl:Class ;
                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasComponent ;
                                     owl:someValuesFrom :Component
                                   ] ;
                   rdfs:comment "An offshore wind power platform that generates electricity from wind."@en ,
                                "Una plataforma eólica offshore que genera energía eléctrica a partir del viento."@es ;
                   rdfs:label "Offshore Wind Power Platform"@en ,
                              "Plataforma eólica offshore"@es .


