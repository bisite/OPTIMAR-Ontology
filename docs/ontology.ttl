#################################################################
#    Individuals
#################################################################

###  https://w3id.org/optimar#ClusteredDistribution
:ClusteredDistribution rdf:type owl:NamedIndividual ,
                                :MooringLineDistribution ;
                       rdfs:comment "Las líneas se agrupan en varios conjuntos alrededor de la plataforma."@es ,
                                    "Lines are grouped into several clusters around the platform."@en ;
                       rdfs:label "Clustered"@en ,
                                  "Distribución agrupada"@es .


###  https://w3id.org/optimar#EvenlyDistributed
:EvenlyDistributed rdf:type owl:NamedIndividual ,
                            :MooringLineDistribution ;
                   rdfs:comment "Las líneas están separadas por ángulos iguales alrededor de la plataforma."@es ,
                                "Lines are separated by equal angles around the platform."@en ;
                   rdfs:label "Distribución uniforme"@es ,
                              "Evenly distributed"@en .


###  https://w3id.org/optimar#SinglePointDistribution
:SinglePointDistribution rdf:type owl:NamedIndividual ,
                                  :MooringLineDistribution ;
                         rdfs:comment "All lines converge at a single point that allows the platform to rotate (weathervaning)."@en ,
                                      "Todas las líneas convergen en un único punto que permite a la plataforma girar (weathervaning)."@es ;
                         rdfs:label "Amarre en un único punto"@es ,
                                    "Single-point mooring"@en .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Actor
                :Component
                :Data
                :EnvironmentalCondition
                :Failure
                :Location
                :Observation
                :OperationalState
                :Role
                :Seabed
                :Sensor
                :WindFarm
                :WindPowerPlatform
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Anchor
                :Fairlead
                :MooringConnector
                :MooringLine
                :Tensioner
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Anemometer
                :CorrosionCamera
                :DynamicMonitor
                :ElectricalSensor
                :GaugeSystem
                :ISUMSystem
                :PitchAngleSensor
                :RotationalSpeedSensor
                :RotorSensor
                :StructuralCamera
                :TemperatureSensor
                :YawSensor
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Brace
                :Column
                :HeavePlate
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :CatenaryMooringSystem
                :TautLegMooringSystem
                :TensionLegMooringSystem
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Corrosion
                :Deformation
                :MaterialFatigue
                :Misalignment
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :DeadWeightAnchor
                :DragEmbedmentAnchor
                :DrivenPileAnchor
                :GravityInstalledAnchor
                :SuctionEmbeddedPlateAnchor
                :SuctionPileAnchor
              )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :ClusteredDistribution
                        :EvenlyDistributed
                        :SinglePointDistribution
                      )
] .


