###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/ns/prov#generated
<http://www.w3.org/ns/prov#generated> rdf:type owl:ObjectProperty ;
                                      rdfs:isDefinedBy <http://www.w3.org/ns/prov#> .


###  http://www.w3.org/ns/prov#wasAssociatedWith
<http://www.w3.org/ns/prov#wasAssociatedWith> rdf:type owl:ObjectProperty ;
                                              rdfs:isDefinedBy <http://www.w3.org/ns/prov#> .


###  http://www.w3.org/ns/prov#wasInformedBy
<http://www.w3.org/ns/prov#wasInformedBy> rdf:type owl:ObjectProperty ;
                                          rdfs:isDefinedBy <http://www.w3.org/ns/prov#> .


###  http://www.w3.org/ns/sosa/hasFeatureOfInterest
<http://www.w3.org/ns/sosa/hasFeatureOfInterest> rdf:type owl:ObjectProperty ;
                                                 rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> .


###  http://www.w3.org/ns/sosa/hasResult
<http://www.w3.org/ns/sosa/hasResult> rdf:type owl:ObjectProperty ;
                                      rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> .


###  http://www.w3.org/ns/sosa/hosts
<http://www.w3.org/ns/sosa/hosts> rdf:type owl:ObjectProperty ;
                                  rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> .


###  http://www.w3.org/ns/sosa/isHostedBy
<http://www.w3.org/ns/sosa/isHostedBy> rdf:type owl:ObjectProperty ;
                                       rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> .


###  http://www.w3.org/ns/sosa/madeBySensor
<http://www.w3.org/ns/sosa/madeBySensor> rdf:type owl:ObjectProperty ;
                                         rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> .


###  https://w3id.org/optimar#actorMonitors
:actorMonitors rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :monitors ;
               rdfs:domain :Actor ;
               rdfs:range [ rdf:type owl:Class ;
                            owl:unionOf ( :Component
                                          :Sensor
                                        )
                          ] ;
               rdfs:comment "Relaciona a un actor con los componentes o sensores que supervisa."@es ,
                            "Relates an actor to the components or sensors they monitor."@en ;
               rdfs:label "Actor monitorea"@es ,
                          "Actor monitors"@en .


###  https://w3id.org/optimar#addressesFailure
:addressesFailure rdf:type owl:ObjectProperty ;
                  rdfs:domain :Maintenance ;
                  rdfs:range :Failure ;
                  rdfs:comment "Relaciona una actividad de mantenimiento con el fallo que corrige o previene."@es ,
                               "Relates a maintenance activity with the failure it corrects or prevents."@en ;
                  rdfs:label "Aborda fallo"@es ,
                             "Addresses failure"@en .


###  https://w3id.org/optimar#adjusts
:adjusts rdf:type owl:ObjectProperty ;
         rdfs:domain :Actor ;
         rdfs:range :Component ;
         rdfs:comment "Indica que un actor realiza ajustes sobre un componente (p. ej. el sistema de pitch)."@es ,
                      "Indicates that an actor makes adjustments on a component (e.g. the pitch system)."@en ;
         rdfs:label "Adjusts"@en ,
                    "Ajusta"@es .


###  https://w3id.org/optimar#affectedBy
:affectedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Component ;
            rdfs:range :Failure ;
            rdfs:comment "Indica que un componente está afectado por un fallo específico."@es ,
                         "Indicates that a component is affected by a specific failure."@en ;
            rdfs:label "Afectado por"@es ,
                       "Affected by"@en .


###  https://w3id.org/optimar#affects
:affects rdf:type owl:ObjectProperty ;
         owl:inverseOf :affectedBy ;
         rdfs:domain :Failure ;
         rdfs:range :Component ;
         rdfs:comment "Indica que un fallo afecta un componente específico."@es ,
                      "Indicates that a failure affects a specific component."@en ;
         rdfs:label "Afecta"@es ,
                    "Affects"@en .


###  https://w3id.org/optimar#analyzes
:analyzes rdf:type owl:ObjectProperty ;
          rdfs:domain :Actor ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :Data
                                     :Failure
                                   )
                     ] ;
          rdfs:comment "Relaciona a un actor con los datos o fallos que estudia o interpreta."@es ,
                       "Relates an actor to the data or failures that it studies or interprets."@en ;
          rdfs:label "Analiza"@es ,
                     "Analyzes"@en .


###  https://w3id.org/optimar#anchorLoad
:anchorLoad rdf:type owl:ObjectProperty ;
            rdfs:domain :Anchor ;
            rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
            rdfs:comment "Carga de diseño que el ancla debe resistir (capacidad de agarre), expresada como valor QUDT."@es ,
                         "Design load the anchor must withstand (holding capacity), expressed as a QUDT quantity value."@en ;
            rdfs:label "Anchor load"@en ,
                       "Carga del ancla"@es .


###  https://w3id.org/optimar#anchoredIn
:anchoredIn rdf:type owl:ObjectProperty ;
            rdfs:domain :Anchor ;
            rdfs:range :Seabed ;
            rdfs:comment "Relaciona un ancla con el fondo marino en el que está instalada."@es ,
                         "Relates an anchor with the seabed in which it is installed."@en ;
            rdfs:label "Anchored in"@en ,
                       "Anclada en"@es .


###  https://w3id.org/optimar#causedBy
:causedBy rdf:type owl:ObjectProperty ;
          rdfs:domain :Event ;
          rdfs:range :Failure ;
          rdfs:comment "Relaciona un evento con el fallo que lo provocó."@es ,
                       "Relates an event with the failure that caused it."@en ;
          rdfs:label "Causado por"@es ,
                     "Caused by"@en .


###  https://w3id.org/optimar#causesFailure
:causesFailure rdf:type owl:ObjectProperty ;
               rdfs:domain :Failure ;
               rdfs:range :Failure ;
               rdfs:comment "Indica que un fallo causa otro fallo (relación de cascada)."@es ,
                            "Indicates that a failure causes another failure (cascade relationship)."@en ;
               rdfs:label "Causa fallo"@es ,
                          "Causes failure"@en .


###  https://w3id.org/optimar#connectedTo
:connectedTo rdf:type owl:ObjectProperty ,
                      owl:SymmetricProperty ;
             rdfs:domain :Component ;
             rdfs:range :Component ;
             rdfs:comment "Indica que un componente está conectado a otro."@es ,
                          "Indicates that a component is connected to another."@en ;
             rdfs:label "Conectado a"@es ,
                        "Connected to"@en .


###  https://w3id.org/optimar#detectedBy
:detectedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Event ;
            rdfs:range :Sensor ;
            rdfs:comment "Relaciona un evento con el sensor que lo detectó."@es ,
                         "Relates an event to the sensor that detected it."@en ;
            rdfs:label "Detectado por"@es ,
                       "Detected by"@en .


###  https://w3id.org/optimar#detects
:detects rdf:type owl:ObjectProperty ;
         owl:inverseOf :detectedBy ;
         rdfs:domain :Sensor ;
         rdfs:range :Event ;
         rdfs:comment "Relaciona un sensor con el evento que detecta."@es ,
                      "Relates a sensor to the event that it detects."@en ;
         rdfs:label "Detecta"@es ,
                    "Detects"@en .


###  https://w3id.org/optimar#detectsCorrosion
:detectsCorrosion rdf:type owl:ObjectProperty ;
                  rdfs:domain :Sensor ;
                  rdfs:range :Corrosion ;
                  rdfs:comment "Relaciona un sensor con la medición de corrosión detectada."@es ,
                               "Relates a sensor with the detected corrosion measurement."@en ;
                  rdfs:label "Detecta corrosión"@es ,
                             "Detects corrosion"@en .


###  https://w3id.org/optimar#diameter
:diameter rdf:type owl:ObjectProperty ;
          rdfs:domain :Component ;
          rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
          rdfs:comment "Diameter of the component measured in QUDT units."@en ,
                       "Diámetro del componente medido en unidades QUDT."@es ;
          rdfs:label "Diameter"@en ,
                     "Diámetro"@es .


###  https://w3id.org/optimar#displacedVolume
:displacedVolume rdf:type owl:ObjectProperty ;
                 rdfs:domain :FloatingSubstructure ;
                 rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
                 rdfs:comment "Volume of water displaced by the floating substructure (hydrostatic displacement), expressed as a QUDT quantity value."@en ,
                              "Volumen de agua desplazado por la subestructura flotante (desplazamiento hidrostático), expresado como valor QUDT."@es ;
                 rdfs:label "Displaced volume"@en ,
                            "Volumen desplazado"@es .


###  https://w3id.org/optimar#draft
:draft rdf:type owl:ObjectProperty ;
       rdfs:domain :FloatingSubstructure ;
       rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
       rdfs:comment "Distancia vertical entre la línea de flotación y el punto más bajo de la subestructura flotante, expresada como valor QUDT."@es ,
                    "Vertical distance between the waterline and the lowest point of the floating substructure, expressed as a QUDT quantity value."@en ;
       rdfs:label "Calado"@es ,
                  "Draft"@en .


###  https://w3id.org/optimar#duration
:duration rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :Event
                                      :Maintenance
                                    )
                      ] ;
          rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
          rdfs:comment "Duración del evento o mantenimiento expresada como valor QUDT."@es ,
                       "Duration of the event or maintenance expressed as a QUDT quantity value."@en ;
          rdfs:label "Duración"@es ,
                     "Duration"@en .


###  https://w3id.org/optimar#elasticModulus
:elasticModulus rdf:type owl:ObjectProperty ;
                rdfs:domain :Component ;
                rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
                rdfs:comment "Elastic modulus of the material of a component, expressed as a QUDT quantity value."@en ,
                             "Módulo de elasticidad del material de un componente, expresado como valor QUDT."@es ;
                rdfs:label "Elastic modulus"@en ,
                           "Módulo elástico"@es .


###  https://w3id.org/optimar#electricalParameterMonitoredBy
:electricalParameterMonitoredBy rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf :monitoredBy ;
                                rdfs:domain :Component ;
                                rdfs:range :ElectricalSensor ;
                                rdfs:comment "Relaciona un componente con el sensor eléctrico que monitorea sus parámetros."@es ,
                                             "Relates a component with the electrical sensor that monitors its parameters."@en ;
                                rdfs:label "Electrical parameter monitored by"@en ,
                                           "Parámetro eléctrico monitoreado por"@es .


###  https://w3id.org/optimar#failureObservation
:failureObservation rdf:type owl:ObjectProperty ;
                    rdfs:domain :FailureEvent ;
                    rdfs:range :Observation ;
                    rdfs:comment "Relación entre un evento de fallo y la observación realizada por un sensor."@es ,
                                 "Relationship between a failure event and the observation made by a sensor."@en ;
                    rdfs:label "Failure observation"@en ,
                               "Observación de fallo"@es .


###  https://w3id.org/optimar#hasAnchor
:hasAnchor rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :hasMooringComponent ;
           rdfs:domain :MooringSystem ;
           rdfs:range :Anchor ;
           rdfs:comment "Relaciona un sistema de amarre con sus anclas."@es ,
                        "Relates a mooring system with its anchors."@en ;
           rdfs:label "Has anchor"@en ,
                      "Tiene ancla"@es .


###  https://w3id.org/optimar#hasCapacity
:hasCapacity rdf:type owl:ObjectProperty ;
             rdfs:domain :Turbine ;
             rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
             rdfs:comment "Capacidad nominal de generación expresada en unidades QUDT (típicamente MW)."@es ,
                          "Nominal generation capacity expressed in QUDT units (typically MW)."@en ;
             rdfs:label "Capacidad nominal"@es ,
                        "Nominal capacity"@en .


###  https://w3id.org/optimar#hasComponent
:hasComponent rdf:type owl:ObjectProperty ;
              rdfs:domain :WindPowerPlatform ;
              rdfs:range :Component ;
              rdfs:comment "Indica que una plataforma eólica offshore tiene un componente específico."@es ,
                           "Indicates that an offshore wind power platform has a specific component."@en ;
              rdfs:label "Has component"@en ,
                         "Tiene componente"@es .


###  https://w3id.org/optimar#hasFailureCause
:hasFailureCause rdf:type owl:ObjectProperty ;
                 rdfs:domain :Failure ;
                 rdfs:range :EnvironmentalCondition ;
                 rdfs:comment "Indica que un fallo tiene su origen en una condición ambiental específica."@es ,
                              "Indicates that a failure is caused by a specific environmental condition."@en ;
                 rdfs:label "Causa de fallo"@es ,
                            "Failure cause"@en .


###  https://w3id.org/optimar#hasGeneratedData
:hasGeneratedData rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://www.w3.org/ns/prov#generated> ;
                  rdfs:domain <http://www.w3.org/ns/prov#Activity> ;
                  rdfs:range :Data ;
                  rdfs:comment "Relaciona un evento o actividad con los datos que genera."@es ,
                               "Relates an event or activity to the data it generates."@en ;
                  rdfs:label "Genera"@es ,
                             "Generates"@en .


###  https://w3id.org/optimar#hasInstalled
:hasInstalled rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <http://www.w3.org/ns/sosa/hosts> ;
              owl:inverseOf :isInstalledIn ;
              rdfs:domain :Component ;
              rdfs:range <http://www.w3.org/ns/sosa/Sensor> ;
              rdfs:comment "Indica que un componente tiene un sensor instalado."@es ,
                           "Indicates that a component has a sensor installed."@en ;
              rdfs:label "Has installed"@en ,
                         "Tiene instalado"@es .


###  https://w3id.org/optimar#hasLineDistribution
:hasLineDistribution rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :MooringSystem ;
                     rdfs:range :MooringLineDistribution ;
                     rdfs:comment "Indica la disposición de las líneas de un sistema de amarre."@es ,
                                  "Indicates the arrangement of the lines of a mooring system."@en ;
                     rdfs:label "Has line distribution"@en ,
                                "Tiene distribución de líneas"@es .


###  https://w3id.org/optimar#hasMember
:hasMember rdf:type owl:ObjectProperty ;
           owl:inverseOf :isMemberOf ;
           rdfs:domain :FloatingSubstructure ;
           rdfs:range :SubstructureMember ;
           rdfs:comment "Relaciona una subestructura flotante con los miembros estructurales que la componen."@es ,
                        "Relates a floating substructure with the structural members that compose it."@en ;
