###  https://w3id.org/optimar#Sensor
:Sensor rdf:type owl:Class ;
        rdfs:subClassOf <http://www.w3.org/ns/sosa/Sensor> ;
        rdfs:comment "A device that measures or monitors parameters of the wind platform, such as wind, corrosion, vibrations, etc."@en ,
                     "Un dispositivo que mide o monitorea parámetros de la plataforma eólica, como viento, corrosión, vibraciones, etc."@es ;
        rdfs:label "Sensor"@en ,
                   "Sensor"@es .


###  https://w3id.org/optimar#StressData
:StressData rdf:type owl:Class ;
            rdfs:subClassOf :Measurement ;
            rdfs:comment "Datos de tensión medidos por un sensor."@es ,
                         "Stress data measured by a sensor."@en ;
            rdfs:label "Datos de tensión"@es ,
                       "Stress Data"@en .


###  https://w3id.org/optimar#StructuralCamera
:StructuralCamera rdf:type owl:Class ;
                  rdfs:subClassOf :Sensor ;
                  rdfs:comment "Camera dedicated to visual inspection of the structural condition of the platform."@en ,
                               "Cámara dedicada a la inspección visual del estado estructural de la plataforma."@es ;
                  rdfs:label "Cámara estructural"@es ,
                             "Structural Camera"@en .


###  https://w3id.org/optimar#StructuralComponent
:StructuralComponent rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:unionOf ( :Base
                                                         :FloatingSubstructure
                                                         :MooringSystem
                                                       )
                                         ] ;
                     rdfs:subClassOf :Component ;
                     rdfs:comment "Los componentes estructurales que componen la infraestructura básica de la plataforma eólica."@es ,
                                  "The structural components that make up the basic infrastructure of the wind platform."@en ;
                     rdfs:label "Componentes estructurales"@es ,
                                "Structural Components"@en .


###  https://w3id.org/optimar#StructuralInstability
:StructuralInstability rdf:type owl:Class ;
                       rdfs:subClassOf :Failure ;
                       rdfs:comment "Failure that compromises the structural stability of the floating platform."@en ,
                                    "Fallo que compromete la estabilidad estructural de la plataforma flotante."@es ;
                       rdfs:label "Inestabilidad estructural"@es ,
                                  "Structural Instability"@en .


###  https://w3id.org/optimar#SubstructureMember
:SubstructureMember rdf:type owl:Class ;
                    rdfs:subClassOf :Component ;
                    rdfs:comment "Elemento estructural que forma parte de una subestructura flotante (columnas, placas de arfada, riostras, etc.)."@es ,
                                 "Structural element that is part of a floating substructure (columns, heave plates, braces, etc.)."@en ;
                    rdfs:label "Miembro de la subestructura"@es ,
                               "Substructure Member"@en .


###  https://w3id.org/optimar#SuctionEmbeddedPlateAnchor
:SuctionEmbeddedPlateAnchor rdf:type owl:Class ;
                            rdfs:subClassOf :Anchor ;
                            rdfs:comment "Ancla de placa instalada mediante un pilote de succión que se recupera tras la instalación."@es ,
                                         "Plate anchor installed by means of a suction follower that is retrieved after installation."@en ;
                            rdfs:label "Ancla de placa embebida por succión (SEPLA)"@es ,
                                       "Suction Embedded Plate Anchor (SEPLA)"@en .


###  https://w3id.org/optimar#SuctionPileAnchor
:SuctionPileAnchor rdf:type owl:Class ;
