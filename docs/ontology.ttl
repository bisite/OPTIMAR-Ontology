###  https://w3id.org/optimar#WindDirectionData
:WindDirectionData rdf:type owl:Class ;
                   rdfs:subClassOf :WindData ;
                   rdfs:comment "Data of the direction from which the wind blows."@en ,
                                "Datos de la dirección desde la que sopla el viento."@es ;
                   rdfs:label "Datos de dirección del viento"@es ,
