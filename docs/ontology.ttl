###  https://w3id.org/optimar#Tower
:Tower rdf:type owl:Class ;
       rdfs:subClassOf :TurbineComponent ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :isSupportedBy ;
                         owl:someValuesFrom :FloatingSubstructure
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :supports ;
                         owl:someValuesFrom :Nacelle
                       ] ;
       rdfs:comment "La estructura que sostiene la turbina eólica."@es ,
                    "The structure that supports the wind turbine."@en ;
       rdfs:label "Torre"@es ,
                  "Tower"@en .


###  https://w3id.org/optimar#Transformer
:Transformer rdf:type owl:Class ;
             rdfs:subClassOf :Component ;
             rdfs:comment "Dispositivo eléctrico que modifica los niveles de voltaje de la energía generada."@es ,
                          "Electrical device that modifies the voltage levels of the generated energy."@en ;
             rdfs:label "Transformador"@es ,
                        "Transformer"@en .


###  https://w3id.org/optimar#Turbine
:Turbine rdf:type owl:Class ;
         rdfs:subClassOf :Component ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasTurbineComponent ;
                           owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                           owl:onClass :Blade
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasTurbineComponent ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Hub
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasTurbineComponent ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Nacelle
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasTurbineComponent ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Tower
                         ] ;
         rdfs:comment "A wind turbine that is part of the wind platform."@en ,
                      "Una turbina de viento que forma parte de la plataforma eólica."@es ;
         rdfs:label "Turbina"@es ,
                    "Turbine"@en .


###  https://w3id.org/optimar#TurbineComponent
:TurbineComponent rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:unionOf ( :Blade
                                                      :Hub
                                                      :Nacelle
                                                      :Tower
                                                    )
                                      ] ;
                  rdfs:subClassOf :Component ;
                  rdfs:comment "Los componentes de la turbina eólica que generan energía a partir del viento."@es ,
                               "The turbine components that generate energy from the wind."@en ;
                  rdfs:label "Componentes de turbina"@es ,
                             "Turbine Components"@en .


