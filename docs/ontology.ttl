          rdfs:comment "Indica que un componente proporciona soporte estructural o funcional a otro."@es ,
                       "Indicates that a component provides structural or functional support to another."@en ;
          rdfs:label "Soporta a"@es ,
                     "Supports"@en .


###  https://w3id.org/optimar#temperature
:temperature rdf:type owl:ObjectProperty ;
             rdfs:domain :Data ;
             rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
             rdfs:comment "Temperatura registrada expresada como un valor con unidad QUDT."@es ,
                          "Temperature recorded expressed as a QUDT quantity value."@en ;
             rdfs:label "Temperatura"@es ,
                        "Temperature"@en .


###  https://w3id.org/optimar#temperatureMonitoredBy
:temperatureMonitoredBy rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :monitoredBy ;
                        owl:inverseOf :measuresTemperatureOf ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :Component
                                                    :EnvironmentalCondition
                                                  )
                                    ] ;
                        rdfs:range :TemperatureSensor ;
                        rdfs:comment "Relaciona un componente o condición ambiental con el sensor de temperatura que lo monitorea."@es ,
                                     "Relates a component or environmental condition with the temperature sensor that monitors it."@en ;
                        rdfs:label "Temperatura monitoreada por"@es ,
                                   "Temperature monitored by"@en .


###  https://w3id.org/optimar#thickness
:thickness rdf:type owl:ObjectProperty ;
           rdfs:domain :Component ;
           rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
           rdfs:comment "Espesor de la sección o pared de un componente medido en unidades QUDT."@es ,
                        "Thickness of the section or wall of a component measured in QUDT units."@en ;
           rdfs:label "Espesor"@es ,
                      "Thickness"@en .


###  https://w3id.org/optimar#transmitsMovementTo
:transmitsMovementTo rdf:type owl:ObjectProperty ;
                     rdfs:domain :Component ;
                     rdfs:range :Component ;
                     rdfs:comment "Indica que un componente transmite movimiento mecánico a otro."@es ,
                                  "Indicates that a component transmits mechanical movement to another."@en ;
                     rdfs:label "Transmite movimiento a"@es ,
                                "Transmits movement to"@en .


###  https://w3id.org/optimar#transportLoad
:transportLoad rdf:type owl:ObjectProperty ;
               rdfs:domain :Anchor ;
               rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
               rdfs:comment "Carga a la que se somete el ancla durante su transporte e instalación, expresada como valor QUDT."@es ,
                            "Load the anchor is subjected to during transport and installation, expressed as a QUDT quantity value."@en ;
               rdfs:label "Carga de transporte"@es ,
                          "Transport load"@en .


###  https://w3id.org/optimar#triggeredBy
:triggeredBy rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://www.w3.org/ns/prov#wasInformedBy> ;
             rdfs:domain :Maintenance ;
             rdfs:range :Event ;
             rdfs:comment "Relaciona una actividad de mantenimiento con el evento (p. ej. un evento de fallo) que la desencadenó."@es ,
                          "Relates a maintenance activity with the event (e.g. a failure event) that triggered it."@en ;
             rdfs:label "Desencadenado por"@es ,
                        "Triggered by"@en .


###  https://w3id.org/optimar#turbineComponentMonitoredBy
:turbineComponentMonitoredBy rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf :monitoredBy ;
                             rdfs:domain :TurbineComponent ;
                             rdfs:range :Sensor ;
                             rdfs:comment "Relaciona un componente de turbina con los sensores que lo supervisan."@es ,
                                          "Relates a turbine component with the sensors that monitor it."@en ;
                             rdfs:label "Es monitoreado por"@es ,
                                        "Is monitored by"@en .


###  https://w3id.org/optimar#vibrationLevel
:vibrationLevel rdf:type owl:ObjectProperty ;
                rdfs:domain :Data ;
                rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
                rdfs:comment "Level of vibrations recorded in a component or system."@en ,
                             "Nivel de vibraciones registradas en un componente o sistema."@es ;
                rdfs:label "Nivel de vibración"@es ,
                           "Vibration level"@en .


###  https://w3id.org/optimar#waterDepth
:waterDepth rdf:type owl:ObjectProperty ;
            rdfs:domain :Location ;
            rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
            rdfs:comment "Profundidad del agua en la ubicación, expresada como valor QUDT."@es ,
                         "Water depth at the location, expressed as a QUDT quantity value."@en ;
            rdfs:label "Profundidad del agua"@es ,
                       "Water depth"@en .


###  https://w3id.org/optimar#width
:width rdf:type owl:ObjectProperty ;
       rdfs:domain :Component ;
       rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
       rdfs:comment "Anchura del componente expresada como un valor con unidad QUDT."@es ,
                    "Width of the component expressed as a QUDT quantity value."@en ;
       rdfs:label "Anchura"@es ,
                  "Width"@en .


###  https://w3id.org/optimar#windDirection
:windDirection rdf:type owl:ObjectProperty ;
               rdfs:domain :EnvironmentalCondition ;
               rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
               rdfs:comment "Dirección desde la que sopla el viento expresada en valores con unidad QUDT."@es ,
                            "Direction from which the wind blows expressed as a QUDT quantity value."@en ;
               rdfs:label "Dirección del viento"@es ,
                          "Wind direction"@en .


###  https://w3id.org/optimar#windSpeed
:windSpeed rdf:type owl:ObjectProperty ;
           rdfs:domain :EnvironmentalCondition ;
           rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
           rdfs:comment "Velocidad del viento expresada como valor QUDT."@es ,
                        "Wind speed expressed as a QUDT quantity value."@en ;
           rdfs:label "Velocidad del viento"@es ,
                      "Wind speed"@en .


###  https://w3id.org/optimar#yawAngleMonitoredBy
:yawAngleMonitoredBy rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :monitoredBy ;
                     owl:inverseOf :monitorsYawOf ;
                     rdfs:domain :Nacelle ;
                     rdfs:range :YawSensor ;
                     rdfs:comment "Relaciona la góndola con el sensor que monitorea su ángulo de orientación."@es ,
                                  "Relates the nacelle with the sensor that monitors its yaw angle."@en ;
                     rdfs:label "Yaw angle monitored by"@en ,
                                "Ángulo de yaw monitoreado por"@es .


