###  http://www.w3.org/ns/sosa/resultTime
<http://www.w3.org/ns/sosa/resultTime> rdf:type owl:DatatypeProperty ;
                                       rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> .


###  https://w3id.org/optimar#corrosionLevel
:corrosionLevel rdf:type owl:DatatypeProperty ;
                rdfs:domain :CorrosionEvent ;
                rdfs:range xsd:decimal ;
                rdfs:comment "General corrosion index detected in a component."@en ,
                             "Índice general de corrosión detectada en un componente."@es ;
                rdfs:label "Corrosion level"@en ,
                           "Nivel de corrosión"@es .


###  https://w3id.org/optimar#darkCorrosionLevel
:darkCorrosionLevel rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf :corrosionLevel ;
                    rdfs:domain :CorrosionEvent ;
                    rdfs:range xsd:decimal ;
                    rdfs:comment "Level of dark corrosion detected on the material surface."@en ,
                                 "Nivel de corrosión oscura detectada en la superficie del material."@es ;
                    rdfs:label "Dark corrosion level"@en ,
                               "Nivel de corrosión oscura"@es .


###  https://w3id.org/optimar#dataFormat
:dataFormat rdf:type owl:DatatypeProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( <http://www.w3.org/ns/sosa/Sensor>
                                        :Data
                                      )
                        ] ;
            rdfs:range xsd:string ;
            rdfs:comment "Format in which the sensor delivers its data or in which a data item is serialised (e.g. CSV, TXT, binary, JPG, MP4, JSON, Modbus)."@en ,
                         "Formato en el que el sensor entrega sus datos o en el que está serializado un dato (p. ej. CSV, TXT, binario, JPG, MP4, JSON, Modbus)."@es ;
            rdfs:label "Data format"@en ,
                       "Formato de datos"@es .


###  https://w3id.org/optimar#dateTime
:dateTime rdf:type owl:DatatypeProperty ;
          rdfs:domain :Measurement ;
          rdfs:range xsd:dateTime ;
          rdfs:comment "Associated temporal mark to the measurement."@en ,
                       "Marca temporal asociada a la medición."@es ;
          rdfs:label "Date and time"@en ,
                     "Fecha y hora"@es .


###  https://w3id.org/optimar#deformationLevel
:deformationLevel rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Data ;
                  rdfs:range xsd:decimal ;
                  rdfs:comment "Degree of deformation recorded in the component."@en ,
                               "Grado de deformación registrado en el componente."@es ;
                  rdfs:label "Deformation level"@en ,
                             "Nivel de Deformación"@es .


###  https://w3id.org/optimar#detectionDateTime
:detectionDateTime rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Failure ;
                   rdfs:range xsd:dateTime ;
                   rdfs:comment "Detection timestamp when the failure was detected."@en ,
                                "Marca temporal de detección del fallo."@es ;
                   rdfs:label "Detection date and time"@en ,
                              "Fecha y hora de detección"@es .


###  https://w3id.org/optimar#displacement
:displacement rdf:type owl:DatatypeProperty ;
              rdfs:domain :Data ;
              rdfs:range xsd:decimal ;
              rdfs:comment "Desplazamiento o cambio de posición registrado en el componente."@es ,
                           "Displacement or position change recorded in the component."@en ;
              rdfs:label "Desplazamiento"@es ,
                         "Displacement"@en .


###  https://w3id.org/optimar#endDateTime
:endDateTime rdf:type owl:DatatypeProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Event
                                         :Maintenance
                                       )
                         ] ;
             rdfs:range xsd:dateTime ;
             rdfs:comment "End timestamp of the event or maintenance."@en ,
                          "Marca temporal de finalización del evento o mantenimiento."@es ;
             rdfs:label "End date and time"@en ,
                        "Fecha y hora de finalización"@es .


###  https://w3id.org/optimar#externalShape
:externalShape rdf:type owl:DatatypeProperty ;
               rdfs:domain :Component ;
               rdfs:range xsd:string ;
               rdfs:comment "Describe la forma externa o geometría del componente."@es ,
                            "Describes the external shape or geometry of the component."@en ;
               rdfs:label "External shape"@en ,
                          "Forma externa"@es .


###  https://w3id.org/optimar#imageURL
:imageURL rdf:type owl:DatatypeProperty ;
          rdfs:domain :Image ;
          rdfs:range xsd:string ;
          rdfs:comment "Access URL of the generated or stored image."@en ,
                       "Dirección de acceso a la imagen generada o almacenada."@es ;
          rdfs:label "Image URL"@en ,
                     "URL de la imagen"@es .


###  https://w3id.org/optimar#lightCorrosion
:lightCorrosion rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf :corrosionLevel ;
                rdfs:domain :CorrosionEvent ;
                rdfs:range xsd:decimal ;
                rdfs:comment "Level of light corrosion detected on the material surface."@en ,
                             "Nivel de corrosión clara detectada en la superficie del material."@es ;
                rdfs:label "Light corrosion level"@en ,
                           "Nivel de corrosión clara"@es .


###  https://w3id.org/optimar#material
:material rdf:type owl:DatatypeProperty ;
          rdfs:domain :Component ;
          rdfs:range xsd:string ;
          rdfs:comment "Material de fabricación del componente (ej. acero, compuesto, fibra de vidrio, etc.)."@es ,
                       "Material of manufacturing of the component (e.g. steel, composite, fiberglass, etc.)."@en ;
          rdfs:label "Material"@en ,
                     "Material"@es .


###  https://w3id.org/optimar#materialFatigue
:materialFatigue rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Data ;
                 rdfs:range xsd:decimal ;
                 rdfs:comment "Accumulated material fatigue degree."@en ,
                              "Grado de fatiga acumulada en el material."@es ;
                 rdfs:label "Fatiga material"@es ,
                            "Material fatigue"@en .


###  https://w3id.org/optimar#materialWear
:materialWear rdf:type owl:DatatypeProperty ;
              rdfs:domain :Data ;
              rdfs:range xsd:decimal ;
              rdfs:comment "Degree of material wear in a component."@en ,
                           "Grado de desgaste de un material en un componente."@es ;
              rdfs:label "Desgaste material"@es ,
                         "Material wear"@en .


###  https://w3id.org/optimar#measurementType
:measurementType rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Measurement ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Especifica el tipo de medida que representa una observación de medida (por ejemplo, máxima, mínima o media)."@es ,
                              "Specifies the type of measurement represented by a measurement observation (e.g., maximum, minimum or average)."@en ;
                 rdfs:label "Measurement type"@en ,
                            "Tipo de medición"@es .


###  https://w3id.org/optimar#misalignmentLevel
:misalignmentLevel rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Data ;
                   rdfs:range xsd:decimal ;
                   rdfs:comment "Measure of the misalignment level detected in a component."@en ,
                                "Medida del grado de desalineación detectada en un componente."@es ;
                   rdfs:label "Misalignment level"@en ,
                              "Nivel de desalineación"@es .


###  https://w3id.org/optimar#numberOfMooringLines
:numberOfMooringLines rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :MooringSystem ;
                      rdfs:range xsd:nonNegativeInteger ;
                      rdfs:comment "Número total de líneas de un sistema de amarre."@es ,
                                   "Total number of lines of a mooring system."@en ;
                      rdfs:label "Number of mooring lines"@en ,
                                 "Número de líneas de amarre"@es .


###  https://w3id.org/optimar#operationalStatus
:operationalStatus rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Turbine ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Current operational status of the turbine as free text. Deprecated since v2.4: use hasOperationalState with an OperationalState individual."@en ,
                                "Estado de funcionamiento actual de la turbina como texto libre. Obsoleta desde la v2.4: usar hasOperationalState con un individuo de OperationalState."@es ;
                   rdfs:label "Estado operativo (texto, obsoleta)"@es ,
                              "Operational status (text, deprecated)"@en ;
                   rdfs:seeAlso :hasOperationalState ;
                   owl:deprecated "true"^^xsd:boolean .


###  https://w3id.org/optimar#reinforcementType
:reinforcementType rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Component ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Descripción de la estructura interna de refuerzo de un componente (p. ej. larguero de fibra de carbono en la pala)."@es ,
                                "Description of the internal reinforcement structure of a component (e.g. carbon fibre spar cap in the blade)."@en ;
                   rdfs:label "Reinforcement type"@en ,
                              "Tipo de refuerzo"@es .


###  https://w3id.org/optimar#severity
:severity rdf:type owl:DatatypeProperty ;
          rdfs:domain :Failure ;
          rdfs:range xsd:string ;
          rdfs:comment "Nivel de severidad del fallo: 'low', 'medium', 'high', 'critical'."@es ,
                       "Severity level of the failure: 'low', 'medium', 'high', 'critical'."@en ;
          rdfs:label "Severidad"@es ,
                     "Severity"@en .


###  https://w3id.org/optimar#soilComposition
:soilComposition rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Seabed ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Tipo o composición del suelo marino (p. ej. arcilla, arena, roca)."@es ,
                              "Type or composition of the seabed soil (e.g. clay, sand, rock)."@en ;
                 rdfs:label "Composición del suelo"@es ,
                            "Soil composition"@en .


###  https://w3id.org/optimar#startDateTime
:startDateTime rdf:type owl:DatatypeProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :Event
                                           :Maintenance
                                         )
                           ] ;
               rdfs:range xsd:dateTime ;
               rdfs:comment "Marca temporal de inicio del evento o mantenimiento."@es ,
                            "Start timestamp of the event or maintenance."@en ;
               rdfs:label "Fecha y hora de inicio"@es ,
                          "Start date and time"@en .


###  https://w3id.org/optimar#unit
:unit rdf:type owl:DatatypeProperty ;
      rdfs:domain :Measurement ;
      rdfs:range xsd:string ;
      rdfs:comment "Measurement unit of the recorded value (e.g. m/s, rpm, °C, etc.)."@en ,
                   "Unidad de medida del valor registrado (ej. m/s, rpm, °C, etc.)."@es ;
      rdfs:label "Unidad"@es ,
                 "Unit"@en .


###  https://w3id.org/optimar#value
:value rdf:type owl:DatatypeProperty ;
       rdfs:domain :Measurement ;
       rdfs:range xsd:decimal ;
       rdfs:comment "Numeric value of the measurement taken by a sensor."@en ,
                    "Valor numérico de la medición tomada por un sensor."@es ;
       rdfs:label "Valor"@es ,
                  "Value"@en .


#################################################################
#    Classes
#################################################################

###  http://qudt.org/schema/qudt/QuantityValue
<http://qudt.org/schema/qudt/QuantityValue> rdf:type owl:Class ;
                                            rdfs:isDefinedBy <http://qudt.org/schema/qudt/> .


###  http://www.w3.org/ns/prov#Activity
<http://www.w3.org/ns/prov#Activity> rdf:type owl:Class ;
                                     rdfs:isDefinedBy <http://www.w3.org/ns/prov#> .


###  http://www.w3.org/ns/prov#Agent
<http://www.w3.org/ns/prov#Agent> rdf:type owl:Class ;
                                  rdfs:isDefinedBy <http://www.w3.org/ns/prov#> .


###  http://www.w3.org/ns/prov#Entity
<http://www.w3.org/ns/prov#Entity> rdf:type owl:Class ;
                                   rdfs:isDefinedBy <http://www.w3.org/ns/prov#> .


###  http://www.w3.org/ns/sosa/FeatureOfInterest
<http://www.w3.org/ns/sosa/FeatureOfInterest> rdf:type owl:Class ;
                                              rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> .


###  http://www.w3.org/ns/sosa/Observation
<http://www.w3.org/ns/sosa/Observation> rdf:type owl:Class ;
                                        rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> .


###  http://www.w3.org/ns/sosa/Result
<http://www.w3.org/ns/sosa/Result> rdf:type owl:Class ;
                                   rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> .


###  http://www.w3.org/ns/sosa/Sensor
<http://www.w3.org/ns/sosa/Sensor> rdf:type owl:Class ;
                                   rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> .


###  https://w3id.org/optimar#ActivePowerSensor
:ActivePowerSensor rdf:type owl:Class ;
                   rdfs:subClassOf :ElectricalSensor ;
                   rdfs:comment "Sensor que mide la potencia activa generada o consumida."@es ,
                                "Sensor that measures the active power generated or consumed."@en ;
                   rdfs:label "Active power sensor"@en ,
                              "Sensor de potencia activa"@es .


###  https://w3id.org/optimar#Actor
:Actor rdf:type owl:Class ;
       rdfs:subClassOf <http://www.w3.org/ns/prov#Agent> ;
       rdfs:comment "An actor that interacts or manages the offshore wind power platform."@en ,
                    "Un actor que interactúa o gestiona la plataforma eólica."@es ;
       rdfs:label "Actor"@en ,
                  "Actor"@es .


###  https://w3id.org/optimar#AnalyticalRole
:AnalyticalRole rdf:type owl:Class ;
                rdfs:subClassOf :Role ;
                rdfs:comment "Rol orientado al análisis de datos y generación de información útil para la toma de decisiones."@es ,
                             "Role focused on data analysis and generation of useful information for decision-making."@en ;
                rdfs:label "Analytical Role"@en ,
                           "Rol analítico"@es .


###  https://w3id.org/optimar#Anchor
:Anchor rdf:type owl:Class ;
        rdfs:subClassOf :MooringComponent ;
        rdfs:comment "Element that fixes a mooring line to the seabed and transfers the mooring loads to the soil."@en ,
                     "Elemento que fija una línea de amarre al fondo marino y transmite las cargas de amarre al suelo."@es ;
        rdfs:label "Anchor"@en ,
                   "Ancla"@es .


###  https://w3id.org/optimar#Anemometer
:Anemometer rdf:type owl:Class ;
            rdfs:subClassOf :Sensor ;
            rdfs:comment "Sensor que mide la velocidad y dirección del viento en el parque eólico."@es ,
                         "Sensor that measures wind speed and direction in the wind farm."@en ;
            rdfs:label "Anemometer"@en ,
                       "Anemómetro"@es .


###  https://w3id.org/optimar#ApparentPowerSensor
:ApparentPowerSensor rdf:type owl:Class ;
                     rdfs:subClassOf :ElectricalSensor ;
                     rdfs:comment "Sensor que mide la potencia aparente del sistema eléctrico."@es ,
                                  "Sensor that measures the apparent power of the electrical system."@en ;
                     rdfs:label "Apparent power sensor"@en ,
                                "Sensor de potencia aparente"@es .


###  https://w3id.org/optimar#Base
:Base rdf:type owl:Class ;
      rdfs:subClassOf :StructuralComponent ;
      rdfs:comment "Elemento de transición entre la torre y la subestructura flotante que transmite las cargas de la turbina a la estructura flotante."@es ,
                   "Transition element between the tower and the floating substructure that transmits the turbine loads to the floating structure."@en ;
      rdfs:label "Base (pieza de transición)"@es ,
                 "Base (transition piece)"@en .


###  https://w3id.org/optimar#Blade
:Blade rdf:type owl:Class ;
       rdfs:subClassOf :TurbineComponent ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :connectedTo ;
                         owl:someValuesFrom :Hub
                       ] ;
       rdfs:comment "Las palas de la turbina que capturan la energía eólica."@es ,
                    "The blades of the turbine that capture the wind energy."@en ;
       rdfs:label "Blade"@en ,
                  "Pala"@es .


###  https://w3id.org/optimar#Brace
:Brace rdf:type owl:Class ;
       rdfs:subClassOf :SubstructureMember ;
       rdfs:comment "Elemento tubular que conecta las columnas de la subestructura flotante y transmite cargas entre ellas."@es ,
                    "Tubular element that connects the columns of the floating substructure and transfers loads between them."@en ;
       rdfs:label "Brace"@en ,
                  "Riostra"@es .


###  https://w3id.org/optimar#CatenaryMooringSystem
:CatenaryMooringSystem rdf:type owl:Class ;
                       rdfs:subClassOf :MooringSystem ;
                       rdfs:comment "Mooring system whose lines hang in a catenary shape and reach the seabed horizontally; the restoring force comes mainly from the line weight."@en ,
                                    "Sistema de amarre cuyas líneas adoptan forma de catenaria y llegan al fondo de forma horizontal; la fuerza de restauración procede principalmente del peso de las líneas."@es ;
                       rdfs:label "Catenary Mooring System"@en ,
                                  "Sistema de amarre en catenaria"@es .


###  https://w3id.org/optimar#CloudAdministrator
:CloudAdministrator rdf:type owl:Class ;
                    rdfs:subClassOf :Actor ;
                    rdfs:comment "Responsable de la administración y seguridad de los servicios en la nube que procesan los datos de la plataforma."@es ,
                                 "Responsible for managing and securing cloud services that process data from the platform."@en ;
                    rdfs:label "Administrador de nube"@es ,
                               "Cloud Administrator"@en .


###  https://w3id.org/optimar#Column
:Column rdf:type owl:Class ;
        rdfs:subClassOf :SubstructureMember ;
        rdfs:comment "Elemento vertical de flotación de una subestructura flotante que aporta flotabilidad y estabilidad hidrostática."@es ,
                     "Vertical buoyant element of a floating substructure that provides buoyancy and hydrostatic stability."@en ;
        rdfs:label "Column"@en ,
                   "Columna"@es .


###  https://w3id.org/optimar#Component
:Component rdf:type owl:Class ;
           rdfs:subClassOf <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
           rdfs:comment "A component of an offshore wind power platform, such as blades, towers, pitch system, etc."@en ,
                        "Un componente de una plataforma eólica offshore, como las palas, torres, sistema de pitch, etc."@es ;
           rdfs:label "Component"@en ,
                      "Componente"@es .


###  https://w3id.org/optimar#ComponentBreakage
:ComponentBreakage rdf:type owl:Class ;
                   rdfs:subClassOf :Failure ;
                   rdfs:comment "Failure caused by the fracture or breakage of an offshore wind platform component."@en ,
                                "Fallo originado por la fractura o rotura de un componente de la plataforma eólica."@es ;
                   rdfs:label "Component Breakage"@en ,
                              "Rotura de componente"@es .


###  https://w3id.org/optimar#Corrosion
:Corrosion rdf:type owl:Class ;
           rdfs:subClassOf :Failure ;
           rdfs:comment "Failure caused by corrosion of the metallic structure of the platform."@en ,
                        "Fallo causado por la corrosión de la estructura metálica de la plataforma."@es ;
           rdfs:label "Corrosion"@en ,
                      "Corrosión"@es .


###  https://w3id.org/optimar#CorrosionCamera
:CorrosionCamera rdf:type owl:Class ;
                 rdfs:subClassOf :Sensor ;
                 rdfs:comment "Camera used to detect and monitor corrosion in the platform structure."@en ,
                              "Cámara utilizada para detectar y monitorear corrosión en la estructura de la plataforma."@es ;
                 rdfs:label "Corrosion Camera"@en ,
                            "Cámara corrosión"@es .


###  https://w3id.org/optimar#CorrosionEvent
:CorrosionEvent rdf:type owl:Class ;
                rdfs:subClassOf :FailureEvent ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :causedBy ;
                                  owl:someValuesFrom :Corrosion
                                ] ;
                rdfs:comment "Event in which degradation of the platform's metallic structure due to corrosion is detected."@en ,
                             "Evento en el que se detecta la degradación de la estructura metálica de la plataforma por efectos de corrosión."@es ;
                rdfs:label "Corrosion Event"@en ,
                           "Evento de detección de corrosión"@es .


###  https://w3id.org/optimar#CurrentData
:CurrentData rdf:type owl:Class ;
             rdfs:subClassOf :ElectricalData ;
             rdfs:comment "Datos de corriente eléctrica."@es ,
                          "Electrical current data."@en ;
             rdfs:label "Current Data"@en ,
                        "Datos de corriente"@es .


###  https://w3id.org/optimar#CurrentSensor
:CurrentSensor rdf:type owl:Class ;
               rdfs:subClassOf :ElectricalSensor ;
               rdfs:comment "Sensor que mide la corriente eléctrica del motor o generador."@es ,
                            "Sensor that measures electrical current of the motor or generator."@en ;
               rdfs:label "Current sensor"@en ,
                          "Sensor de corriente"@es .


###  https://w3id.org/optimar#Data
:Data rdf:type owl:Class ;
      rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ,
                      <http://www.w3.org/ns/sosa/Result> ;
      rdfs:comment "A class for representing the measurement data collected by sensors or other systems."@en ,
                   "Una clase general para representar los datos de medición recolectados por sensores u otros sistemas."@es ;
      rdfs:label "Data"@en ,
                 "Dato"@es .


###  https://w3id.org/optimar#DataAnalyst
:DataAnalyst rdf:type owl:Class ;
             rdfs:subClassOf :Actor ;
             rdfs:comment "Especialista que analiza los datos recolectados para detectar patrones, fallos y oportunidades de optimización."@es ,
                          "Specialist who analyzes collected data to detect patterns, failures, and optimization opportunities."@en ;
             rdfs:label "Analista de datos"@es ,
                        "Data Analyst"@en .


###  https://w3id.org/optimar#DeadWeightAnchor
:DeadWeightAnchor rdf:type owl:Class ;
                  rdfs:subClassOf :Anchor ;
                  rdfs:comment "Anchor that resists loads mainly through its own weight and friction with the seabed."@en ,
                               "Ancla que resiste las cargas principalmente por su propio peso y la fricción con el fondo marino."@es ;
                  rdfs:label "Ancla de peso muerto"@es ,
                             "Dead Weight Anchor"@en .


###  https://w3id.org/optimar#Deformation
:Deformation rdf:type owl:Class ;
             rdfs:subClassOf :Failure ;
             rdfs:comment "Failure caused by structural deformation of a component."@en ,
                          "Fallo causado por la deformación estructural de un componente."@es ;
             rdfs:label "Deformación estructural"@es ,
                        "Structural deformation"@en .


###  https://w3id.org/optimar#DragEmbedmentAnchor
:DragEmbedmentAnchor rdf:type owl:Class ;
                     rdfs:subClassOf :Anchor ;
                     rdfs:comment "Anchor installed by dragging it along the seabed until it penetrates the soil."@en ,
                                  "Ancla que se instala arrastrándola sobre el fondo hasta que penetra en el suelo."@es ;
                     rdfs:label "Ancla de arrastre (DEA)"@es ,
                                "Drag Embedment Anchor (DEA)"@en .


###  https://w3id.org/optimar#DrivenPileAnchor
:DrivenPileAnchor rdf:type owl:Class ;
                  rdfs:subClassOf :Anchor ;
                  rdfs:comment "Pilote tubular hincado en el fondo marino mediante martillo."@es ,
                               "Tubular pile driven into the seabed by hammering."@en ;
                  rdfs:label "Driven Pile Anchor"@en ,
                             "Pilote hincado"@es .


###  https://w3id.org/optimar#DynamicMonitor
:DynamicMonitor rdf:type owl:Class ;
                rdfs:subClassOf :Sensor ;
                rdfs:comment "Device that measures dynamic parameters of the platform, such as vibrations and movements."@en ,
                             "Dispositivo que mide parámetros dinámicos de la plataforma como vibraciones y movimientos."@es ;
                rdfs:label "Dynamic Monitor"@en ,
                           "Monitor dinámico"@es .


###  https://w3id.org/optimar#ElectricalData
:ElectricalData rdf:type owl:Class ;
                rdfs:subClassOf :Measurement ;
                rdfs:comment "Datos de parámetros eléctricos medidos por un sensor."@es ,
                             "Electrical parameter data measured by a sensor."@en ;
                rdfs:label "Datos eléctricos"@es ,
                           "Electrical Data"@en .


###  https://w3id.org/optimar#ElectricalSensor
:ElectricalSensor rdf:type owl:Class ;
                  rdfs:subClassOf :Sensor ;
                  rdfs:comment "Sensor que mide parámetros eléctricos de la turbina."@es ,
                               "Sensor that measures electrical parameters of the turbine."@en ;
                  rdfs:label "Electrical sensor"@en ,
                             "Sensor eléctrico"@es .


###  https://w3id.org/optimar#EnvironmentalCondition
:EnvironmentalCondition rdf:type owl:Class ;
                        rdfs:subClassOf <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                        rdfs:comment "Las condiciones ambientales que afectan a la plataforma eólica, como la velocidad del viento, la temperatura, etc."@es ,
                                     "The environmental conditions that affect the offshore wind power platform, such as wind speed, temperature, etc."@en ;
                        rdfs:label "Condición ambiental"@es ,
                                   "Environmental Condition"@en .


###  https://w3id.org/optimar#Event
:Event rdf:type owl:Class ;
       rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ;
       owl:disjointWith :Failure ,
                        :Task ;
       rdfs:comment "An event that occurs in the offshore wind power platform, such as a failure detection."@en ,
                    "Un evento que ocurre en la plataforma eólica, como la detección de un fallo."@es ;
       rdfs:label "Event"@en ,
                  "Evento"@es .


###  https://w3id.org/optimar#Failure
:Failure rdf:type owl:Class ;
         rdfs:comment "A class that represents identified failures in the wind platform."@en ,
                      "Una clase que representa fallos identificados en la plataforma eólica."@es ;
         rdfs:label "Failure"@en ,
                    "Fallo"@es .


###  https://w3id.org/optimar#FailureEvent
:FailureEvent rdf:type owl:Class ;
              rdfs:subClassOf :Event ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :causedBy ;
                                owl:someValuesFrom :Failure
                              ] ;
              rdfs:comment "Event that represents a detected failure in the system, must be caused by at least one failure."@en ,
                           "Evento que representa un fallo detectado en el sistema, debe estar causado por al menos un fallo. "@es ;
              rdfs:label "Evento de fallo"@es ,
                         "Failure Event"@en .


###  https://w3id.org/optimar#Fairlead
:Fairlead rdf:type owl:Class ;
          rdfs:subClassOf :MooringComponent ;
          rdfs:comment "Connection point between a mooring line and the floating substructure."@en ,
                       "Punto de conexión entre una línea de amarre y la subestructura flotante."@es ;
          rdfs:label "Fairlead"@en ,
                     "Fairlead"@es .


###  https://w3id.org/optimar#FloatingPlatform
:FloatingPlatform rdf:type owl:Class ;
                  rdfs:subClassOf :WindPowerPlatform ;
                  rdfs:comment "An offshore wind power platform that includes a turbine, floating substructure, and mooring system"@en ,
                               "Plataforma eólica offshore completa que incluye turbina, subestructura flotante y sistema de amarre."@es ;
                  rdfs:label "Floating Wind Power Platform"@en ,
                             "Plataforma eólica flotante"@es .


###  https://w3id.org/optimar#FloatingSubstructure
:FloatingSubstructure rdf:type owl:Class ;
                      rdfs:subClassOf :StructuralComponent ;
                      rdfs:comment "La estructura sumergida que proporciona flotabilidad (spar, semi-sumergible, TLP, etc.)"@es ,
                                   "The submerged structure that provides buoyancy and stability (spar, semi-submersible, TLP, etc.)"@en ;
                      rdfs:label "Floating Substructure"@en ,
                                 "Subestructura flotante"@es .


###  https://w3id.org/optimar#FrequencyData
:FrequencyData rdf:type owl:Class ;
               rdfs:subClassOf :ElectricalData ;
               rdfs:comment "Datos de frecuencia de red eléctrica."@es ,
                            "Electrical grid frequency data."@en ;
               rdfs:label "Datos de frecuencia"@es ,
                          "Frequency Data"@en .


###  https://w3id.org/optimar#GaugeSystem
:GaugeSystem rdf:type owl:Class ;
             rdfs:subClassOf :Sensor ;
             rdfs:comment "Sistema de galgas extensiométricas utilizado para medir tensiones y deformaciones en la estructura."@es ,
                          "Strain gauge system used to measure stresses and deformations in the structure."@en ;
             rdfs:label "Gauge System"@en ,
                        "Sistema de galgas"@es .


###  https://w3id.org/optimar#Gearbox
:Gearbox rdf:type owl:Class ;
         rdfs:subClassOf :Component ;
         rdfs:comment "Sistema de transmisión que ajusta la velocidad de rotación entre el rotor y el generador."@es ,
                      "Transmission system that adjusts the rotation speed between the rotor and the generator."@en ;
         rdfs:label "Caja de cambios"@es ,
                    "Gearbox"@en .


###  https://w3id.org/optimar#Generator
:Generator rdf:type owl:Class ;
           rdfs:subClassOf :Component ;
           rdfs:comment "Electrical generator that converts mechanical energy into electrical energy."@en ,
                        "Generador eléctrico que convierte energía mecánica en eléctrica."@es ;
           rdfs:label "Generador"@es ,
                      "Generator"@en .


###  https://w3id.org/optimar#GravityInstalledAnchor
:GravityInstalledAnchor rdf:type owl:Class ;
                        rdfs:subClassOf :Anchor ;
                        rdfs:comment "Ancla en forma de torpedo que penetra en el fondo marino por caída libre."@es ,
                                     "Torpedo-shaped anchor that penetrates the seabed by free fall."@en ;
                        rdfs:label "Ancla instalada por gravedad"@es ,
                                   "Gravity Installed Anchor"@en .


###  https://w3id.org/optimar#GridFrequencySensor
:GridFrequencySensor rdf:type owl:Class ;
                     rdfs:subClassOf :ElectricalSensor ;
                     rdfs:comment "Sensor que mide la frecuencia de la red eléctrica."@es ,
                                  "Sensor that measures grid electrical frequency."@en ;
                     rdfs:label "Grid frequency sensor"@en ,
                                "Sensor de frecuencia de la red"@es .


###  https://w3id.org/optimar#HeavePlate
:HeavePlate rdf:type owl:Class ;
            rdfs:subClassOf :SubstructureMember ;
            rdfs:comment "Horizontal plate at the bottom of the columns that increases added mass and damping of the heave motion."@en ,
                         "Placa horizontal situada en la parte inferior de las columnas que aumenta la masa añadida y el amortiguamiento del movimiento de arfada."@es ;
            rdfs:label "Heave Plate"@en ,
                       "Placa de arfada"@es .


###  https://w3id.org/optimar#Hub
:Hub rdf:type owl:Class ;
     rdfs:subClassOf :TurbineComponent ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :connectedTo ;
                       owl:someValuesFrom :Blade
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :transmitsMovementTo ;
                       owl:someValuesFrom :Generator
                     ] ;
     rdfs:comment "La parte central de la turbina donde se conectan las palas."@es ,
                  "The central part of the turbine where the blades are connected."@en ;
     rdfs:label "Hub"@en ,
                "Hub"@es .


###  https://w3id.org/optimar#ISUMSystem
:ISUMSystem rdf:type owl:Class ;
            rdfs:subClassOf :Sensor ;
            rdfs:comment "Sistema especializado para la monitorización integrada de la plataforma offshore."@es ,
                         "Specialized system for integrated monitoring of the offshore platform."@en ;
            rdfs:label "ISUM System"@en ,
                       "Sistema ISUM"@es .


###  https://w3id.org/optimar#Image
:Image rdf:type owl:Class ;
       rdfs:subClassOf :Data ;
       rdfs:comment "A class that represents an image that supports the measurement."@en ,
                    "Una clase que representa una imagen que soporta la medición."@es ;
       rdfs:label "Image"@en ,
                  "Imagen"@es .


###  https://w3id.org/optimar#Inverter
:Inverter rdf:type owl:Class ;
          rdfs:subClassOf :Component ;
          rdfs:comment "Componente electrónico de potencia que convierte la energía eléctrica."@es ,
                       "Power electronic component that converts electrical power."@en ;
          rdfs:label "Inversor"@es ,
                     "Inverter"@en .


###  https://w3id.org/optimar#Location
:Location rdf:type owl:Class ;
          rdfs:comment "La ubicación geográfica de la plataforma eólica."@es ,
                       "The geographic location of the wind platform."@en ;
          rdfs:label "Location"@en ,
                     "Ubicación"@es .


###  https://w3id.org/optimar#Maintenance
:Maintenance rdf:type owl:Class ;
             rdfs:subClassOf :Task ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :performedBy ;
                               owl:someValuesFrom :MaintenanceOperator
                             ] ;
             rdfs:comment "A class that represents the maintenance of the wind platform."@en ,
                          "Una clase que representa el mantenimiento de la plataforma eólica."@es ;
             rdfs:label "Maintenance"@en ,
                        "Mantenimiento"@es .


###  https://w3id.org/optimar#MaintenanceOperator
:MaintenanceOperator rdf:type owl:Class ;
                     rdfs:subClassOf :Actor ;
                     rdfs:comment "Person responsible for carrying out preventive and corrective maintenance on the platform."@en ,
                                  "Persona encargada de realizar el mantenimiento preventivo y correctivo en la plataforma."@es ;
                     rdfs:label "Maintenance Operator"@en ,
                                "Operador de mantenimiento"@es .


###  https://w3id.org/optimar#ManagementRole
:ManagementRole rdf:type owl:Class ;
                rdfs:subClassOf :Role ;
                rdfs:comment "Rol encargado de la coordinación, planificación y gestión de recursos en la plataforma eólica."@es ,
                             "Role responsible for coordination, planning, and resource management in the wind platform."@en ;
                rdfs:label "Management Role"@en ,
                           "Rol de gestión"@es .


###  https://w3id.org/optimar#MaterialFatigue
:MaterialFatigue rdf:type owl:Class ;
                 rdfs:subClassOf :Failure ;
                 rdfs:comment "Fallo en el material estructural causado por ciclos repetidos de carga."@es ,
                              "Structural material failure caused by repeated load cycles."@en ;
                 rdfs:label "Fatiga del material"@es ,
                            "Material Fatigue"@en .


###  https://w3id.org/optimar#Measurement
:Measurement rdf:type owl:Class ;
             rdfs:subClassOf :Data ;
             rdfs:comment "Representa una medición tomada por un sensor."@es ,
                          "Represents a measurement taken by a sensor."@en ;
             rdfs:label "Measurement"@en ,
                        "Medición"@es .


###  https://w3id.org/optimar#Misalignment
:Misalignment rdf:type owl:Class ;
              rdfs:subClassOf :Failure ;
              rdfs:comment "Failure caused by misalignment or lack of proper adjustment between platform components."@en ,
                           "Fallo causado por el desajuste o falta de alineación entre los componentes de la plataforma."@es ;
              rdfs:label "Desalineación"@es ,
                         "Misalignment"@en .


###  https://w3id.org/optimar#MonitoringTask
:MonitoringTask rdf:type owl:Class ;
                rdfs:subClassOf :Task ;
                rdfs:comment "A task aimed at supervising the condition of the platform through sensors and monitoring systems."@en ,
                             "Una tarea destinada a supervisar el estado de la plataforma mediante sensores y sistemas de monitorización."@es ;
                rdfs:label "Monitoring Task"@en ,
                           "Tarea de monitoreo"@es .


###  https://w3id.org/optimar#MooringComponent
:MooringComponent rdf:type owl:Class ;
                  rdfs:subClassOf :Component ;
                  rdfs:comment "Element that is part of a mooring system (lines, anchors, connectors, tensioners, fairleads)."@en ,
                               "Elemento que forma parte de un sistema de amarre (líneas, anclas, conectores, tensores, fairleads)."@es ;
                  rdfs:label "Componente de amarre"@es ,
                             "Mooring Component"@en .


###  https://w3id.org/optimar#MooringConnector
:MooringConnector rdf:type owl:Class ;
                  rdfs:subClassOf :MooringComponent ;
                  rdfs:comment "Elemento de unión entre tramos de línea de amarre o entre la línea y el ancla (grilletes, eslabones, etc.)."@es ,
                               "Joining element between mooring line segments or between the line and the anchor (shackles, links, etc.)."@en ;
                  rdfs:label "Conector de amarre"@es ,
                             "Mooring Connector"@en .


###  https://w3id.org/optimar#MooringLine
:MooringLine rdf:type owl:Class ;
             rdfs:subClassOf :MooringComponent ;
             rdfs:comment "Cadena, cable o cabo sintético que une la subestructura flotante con el ancla."@es ,
                          "Chain, wire rope or synthetic rope that connects the floating substructure with the anchor."@en ;
             rdfs:label "Línea de amarre"@es ,
                        "Mooring Line"@en .


###  https://w3id.org/optimar#MooringLineDistribution
:MooringLineDistribution rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Class ;
                                               owl:oneOf ( :ClusteredDistribution
                                                           :EvenlyDistributed
                                                           :SinglePointDistribution
                                                         )
                                             ] ;
                         rdfs:comment "Disposición geométrica de las líneas de amarre alrededor de la plataforma."@es ,
                                      "Geometric arrangement of the mooring lines around the platform."@en ;
                         rdfs:label "Distribución de líneas de amarre"@es ,
                                    "Mooring Line Distribution"@en .


###  https://w3id.org/optimar#MooringSystem
:MooringSystem rdf:type owl:Class ;
               rdfs:subClassOf :StructuralComponent ;
               rdfs:comment "El sistema de amarre que mantiene la plataforma flotante en su ubicación."@es ,
                            "The mooring system that keeps the floating platform in place."@en ;
               rdfs:label "Mooring System"@en ,
                          "Sistema de amarre"@es .


###  https://w3id.org/optimar#Nacelle
:Nacelle rdf:type owl:Class ;
         rdfs:subClassOf :TurbineComponent ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :houses ;
                           owl:someValuesFrom :Generator
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :isSupportedBy ;
                           owl:someValuesFrom :Tower
                         ] ;
         rdfs:comment "El compartimento de la turbina que aloja el generador y otros componentes mecánicos."@es ,
                      "The turbine component that houses the generator and other mechanical components."@en ;
         rdfs:label "Nacelle"@en ,
                    "Nacelle"@es .


###  https://w3id.org/optimar#Observation
:Observation rdf:type owl:Class ;
             rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :madeBySensor ;
                               owl:someValuesFrom :Sensor
                             ] ;
             rdfs:comment "El resultado de registrar un fenómeno o condición, normalmente a través de un sensor o sistema de monitorización."@es ,
                          "The result of recording a phenomenon or condition, usually through a sensor or monitoring system."@en ;
             rdfs:label "Observación"@es ,
                        "Observation"@en .


###  https://w3id.org/optimar#OperationalState
:OperationalState rdf:type owl:Class ;
                  rdfs:comment "El estado operativo de un componente o sistema de la plataforma eólica."@es ,
                               "The operational state of a component or system of the offshore wind power platform."@en ;
                  rdfs:label "Estado operativo"@es ,
                             "Operational state"@en .


###  https://w3id.org/optimar#ParkOwner
:ParkOwner rdf:type owl:Class ;
           rdfs:subClassOf :Actor ;
           rdfs:comment "Entidad o persona propietaria del parque eólico offshore y responsable de su operación general."@es ,
                        "Entity or individual owning the offshore wind farm and responsible for its overall operation."@en ;
           rdfs:label "Park Owner"@en ,
                      "Propietario de parque"@es .


###  https://w3id.org/optimar#PermanentMooringSystem
:PermanentMooringSystem rdf:type owl:Class ;
                        rdfs:subClassOf :MooringSystem ;
                        owl:disjointWith :TemporaryMooringSystem ;
                        rdfs:comment "Mooring system designed to keep the platform in position during its whole operational life."@en ,
                                     "Sistema de amarre diseñado para mantener la plataforma en posición durante toda su vida operativa."@es ;
                        rdfs:label "Permanent Mooring System"@en ,
                                   "Sistema de amarre permanente"@es .


###  https://w3id.org/optimar#PitchAngleData
:PitchAngleData rdf:type owl:Class ;
                rdfs:subClassOf :Measurement ;
                rdfs:comment "Datos del ángulo de pitch de las palas."@es ,
                             "Pitch angle data of the blades."@en ;
                rdfs:label "Datos de ángulo de pitch"@es ,
                           "Pitch Angle Data"@en .


###  https://w3id.org/optimar#PitchAngleSensor
:PitchAngleSensor rdf:type owl:Class ;
                  rdfs:subClassOf :Sensor ;
                  rdfs:comment "Sensor que mide el ángulo de pitch (inclinación) de las palas de la turbina."@es ,
                               "Sensor that measures the pitch angle (inclination) of the turbine blades."@en ;
                  rdfs:label "Pitch angle sensor"@en ,
                             "Sensor de ángulo de pitch"@es .


###  https://w3id.org/optimar#PitchSystem
:PitchSystem rdf:type owl:Class ;
             rdfs:subClassOf :Component ;
             rdfs:comment "El sistema que ajusta el ángulo de las palas de la turbina."@es ,
                          "The system that adjusts the angle of the blades of the turbine."@en ;
             rdfs:label "Pitch System"@en ,
                        "Sistema de pitch"@es .


###  https://w3id.org/optimar#PlatformActuator
:PlatformActuator rdf:type owl:Class ;
                  rdfs:subClassOf :Actor ;
                  rdfs:comment "Encargado de realizar ajustes sobre la plataforma, como ajustes mecánicos o hidráulicos."@es ,
                               "Responsible for making adjustments on the platform, such as mechanical or hydraulic adjustments."@en ;
                  rdfs:label "Actuador de plataforma"@es ,
                             "Platform Actuator"@en .


###  https://w3id.org/optimar#PowerData
:PowerData rdf:type owl:Class ;
           rdfs:subClassOf :ElectricalData ;
           rdfs:comment "Active or reactive power data."@en ,
                        "Datos de potencia activa o reactiva."@es ;
           rdfs:label "Datos de potencia"@es ,
                      "Power Data"@en .


###  https://w3id.org/optimar#ReactivePowerSensor
:ReactivePowerSensor rdf:type owl:Class ;
                     rdfs:subClassOf :ElectricalSensor ;
                     rdfs:comment "Sensor que mide la potencia reactiva del sistema eléctrico."@es ,
                                  "Sensor that measures the reactive power of the electrical system."@en ;
                     rdfs:label "Reactive power sensor"@en ,
                                "Sensor de potencia reactiva"@es .


###  https://w3id.org/optimar#Role
:Role rdf:type owl:Class ;
      rdfs:comment "Los roles de los actores que gestionan, operan o mantienen la plataforma eólica."@es ,
                   "The roles of the actors that manage, operate or maintain the offshore wind power platform."@en ;
      rdfs:label "Rol"@es ,
                 "Role"@en .


###  https://w3id.org/optimar#RotationalSpeedSensor
:RotationalSpeedSensor rdf:type owl:Class ;
                       rdfs:subClassOf :Sensor ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :isInstalledIn ;
                                         owl:someValuesFrom [ rdf:type owl:Class ;
                                                              owl:unionOf ( :Gearbox
                                                                            :Generator
                                                                          )
                                                            ]
                                       ] ;
                       rdfs:comment "Sensor instalado en la caja de cambios o el generador que mide la velocidad rotacional del eje de transmisión."@es ,
                                    "Sensor installed in the gearbox or the generator that measures the rotational speed of the drivetrain shaft."@en ;
                       rdfs:label "Rotational speed sensor"@en ,
                                  "Sensor de velocidad rotacional"@es .


