    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#isHousedIn">
        <owl:inverseOf rdf:resource="https://w3id.org/optimar#houses"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Indica que un componente está fisicamente contenido dentro de otro.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a component is physically contained within another.</rdfs:comment>
        <rdfs:label xml:lang="es">Está alojado en</rdfs:label>
        <rdfs:label xml:lang="en">Is housed in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#isInstalledIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#isInstalledIn">
        <rdfs:domain rdf:resource="https://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Indica que un sensor está instalado en un componente.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a sensor is installed in a component.</rdfs:comment>
        <rdfs:label xml:lang="es">Está instalado en</rdfs:label>
        <rdfs:label xml:lang="en">Is installed in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#isPartOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#isPartOf">
        <owl:inverseOf rdf:resource="https://w3id.org/optimar#hasTurbineComponent"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#TurbineComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Turbine"/>
        <rdfs:comment xml:lang="es">Indica que un componente de turbina forma parte de una turbina específica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a turbine component is part of a specific turbine.</rdfs:comment>
        <rdfs:label xml:lang="es">Es parte de</rdfs:label>
        <rdfs:label xml:lang="en">Is part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#isSupportedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#isSupportedBy">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Indica que un componente depende estructural o funcionalmente de otro para su soporte.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a component is structurally or functionally supported by another.</rdfs:comment>
        <rdfs:label xml:lang="es">Es soportado por</rdfs:label>
        <rdfs:label xml:lang="en">Is supported by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#length -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#length">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
