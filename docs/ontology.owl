        <rdfs:label xml:lang="en">Measures wind direction</rdfs:label>
        <rdfs:label xml:lang="es">Mide dirección del viento</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#measuresWindSpeed -->


