                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relaciona un sensor de temperatura con el componente o condición ambiental cuya temperatura mide.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a temperature sensor with the component or environmental condition whose temperature it measures.</rdfs:comment>
        <rdfs:label xml:lang="en">Measures temperature of</rdfs:label>
        <rdfs:label xml:lang="es">Mide temperatura de</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#measuresVibration -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#measuresVibration">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#measures"/>
