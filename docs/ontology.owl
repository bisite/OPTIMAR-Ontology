        <rdfs:comment xml:lang="en">Relates an observation to the sensor that made it.</rdfs:comment>
        <rdfs:label xml:lang="en">Made by sensor</rdfs:label>
        <rdfs:label xml:lang="es">Realizada por sensor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#manages -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#manages">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Actor"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#MooringSystem"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#WindPowerPlatform"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Indica que un actor se encarga de la gestión de una plataforma eólica o su sistema de anclaje.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that an actor is responsible for managing a wind power platform or its mooring system.</rdfs:comment>
        <rdfs:label xml:lang="es">Administra</rdfs:label>
        <rdfs:label xml:lang="en">Manages</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#mass -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#mass">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
