    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/ns/prov#generated -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#generated"/>
    


    <!-- https://w3id.org/optimar#actorMonitors -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#actorMonitors">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#monitors"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Actor"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#Component"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#Sensor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relaciona a un actor con los componentes o sensores que supervisa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an actor to the components or sensors they monitor.</rdfs:comment>
        <rdfs:label xml:lang="es">Actor monitorea</rdfs:label>
        <rdfs:label xml:lang="en">Actor monitors</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#adjusts -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#adjusts">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Actor"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#Component"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#PitchSystem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Indica que un actor realiza ajustes sobre un componente o sistema de pitch.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that an actor makes adjustments on a component or pitch system.</rdfs:comment>
        <rdfs:label xml:lang="en">Adjusts</rdfs:label>
        <rdfs:label xml:lang="es">Ajusta</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#affectedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#affectedBy">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:comment xml:lang="es">Indica que un componente de turbina está afectado por un fallo específico.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a turbine component is affected by a specific failure.</rdfs:comment>
        <rdfs:label xml:lang="es">Afectado por</rdfs:label>
        <rdfs:label xml:lang="en">Affected by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#affects -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#affects">
        <owl:inverseOf rdf:resource="https://w3id.org/optimar#affectedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Indica que un fallo afecta un componente específico.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a failure affects a specific component.</rdfs:comment>
        <rdfs:label xml:lang="es">Afecta</rdfs:label>
        <rdfs:label xml:lang="en">Affects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#analyzes -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#analyzes">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Actor"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#Data"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#Failure"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relaciona a un actor con los datos o fallos que estudia o interpreta.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an actor to the data or failures that it studies or interprets.</rdfs:comment>
        <rdfs:label xml:lang="es">Analiza</rdfs:label>
        <rdfs:label xml:lang="en">Analyzes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#causedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#causedBy">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Event"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:comment xml:lang="es">Relaciona un evento con el fallo que lo provocó.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an event with the failure that caused it.</rdfs:comment>
        <rdfs:label xml:lang="es">Causado por</rdfs:label>
        <rdfs:label xml:lang="en">Caused by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#causesFailure -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#causesFailure">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:comment xml:lang="es">Indica que un fallo causa otro fallo (realación de cascada)</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a failure causes another failure (cascade relationship)</rdfs:comment>
        <rdfs:label xml:lang="es">Causa fallo</rdfs:label>
        <rdfs:label xml:lang="en">Causes failure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#connectedTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#connectedTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Indica que un componente está conectado a otro.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a component is connected to another.</rdfs:comment>
        <rdfs:label xml:lang="es">Conectado a</rdfs:label>
        <rdfs:label xml:lang="en">Connected to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#detectedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#detectedBy">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Event"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:comment xml:lang="es">Relaciona un evento con el sensor que lo detectó.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an event to the sensor that detected it.</rdfs:comment>
        <rdfs:label xml:lang="es">Detectado por</rdfs:label>
        <rdfs:label xml:lang="en">Detected by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#detects -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#detects">
        <owl:inverseOf rdf:resource="https://w3id.org/optimar#detectedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Event"/>
        <rdfs:comment xml:lang="es">Relaciona un sensor con el evento que detecta.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a sensor to the event that it detects.</rdfs:comment>
        <rdfs:label xml:lang="es">Detecta</rdfs:label>
        <rdfs:label xml:lang="en">Detects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#detectsCorrosion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#detectsCorrosion">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Corrosion"/>
        <rdfs:comment xml:lang="es">Relaciona un sensor con la medición de corrosión detectada.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a sensor with the detected corrosion measurement.</rdfs:comment>
        <rdfs:label xml:lang="es">Detecta corrosión</rdfs:label>
        <rdfs:label xml:lang="en">Detects corrosion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#diameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#diameter">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="en">Diameter of the component measured in QUDT units.</rdfs:comment>
        <rdfs:comment xml:lang="es">Diámetro del componente medido en unidades QUDT.</rdfs:comment>
        <rdfs:label xml:lang="en">Diameter</rdfs:label>
        <rdfs:label xml:lang="es">Diámetro</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#duration -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#duration">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#Event"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#Maintenance"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Duración del evento o mantenimiento expresada como valor QUDT.</rdfs:comment>
        <rdfs:comment xml:lang="en">Duration of the event or maintenance expressed as a QUDT quantity value.</rdfs:comment>
        <rdfs:label xml:lang="es">Duración</rdfs:label>
        <rdfs:label xml:lang="en">Duration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#electricalParameterMonitoredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#electricalParameterMonitoredBy">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#monitoredBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#ElectricalSensor"/>
        <rdfs:comment xml:lang="es">Relaciona un componente con el sensor eléctrico que monitorea sus parámetros.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a component with the electrical sensor that monitors its parameters.</rdfs:comment>
        <rdfs:label xml:lang="en">Electrical parameter monitored by</rdfs:label>
        <rdfs:label xml:lang="es">Parámetro eléctrico monitoreado por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#failureObservation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#failureObservation">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#FailureEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Observation"/>
        <rdfs:comment xml:lang="es">Relación entre un evento de fallo y la observación realizada por un sensor.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relationship between a failure event and the observation made by a sensor.</rdfs:comment>
        <rdfs:label xml:lang="en">Failure observation</rdfs:label>
        <rdfs:label xml:lang="es">Observación de fallo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasCapacity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasCapacity">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Turbine"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Capacidad nominal de generación expresada en unidades QUDT (tipicamente MW).</rdfs:comment>
        <rdfs:comment xml:lang="en">Nominal generation capacity expressed in QUDT units (typically MW).</rdfs:comment>
        <rdfs:label xml:lang="es">Capacidad nominal</rdfs:label>
        <rdfs:label xml:lang="en">Nominal capacity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasComponent">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#WindPowerPlatform"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Indica que una plataforma eólica offshore tiene un componente específico.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that an offshore wind power platform has a specific component.</rdfs:comment>
        <rdfs:label xml:lang="en">Has component</rdfs:label>
        <rdfs:label xml:lang="es">Tiene componente</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasFailureCause -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasFailureCause">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#EnvironmentalCondition"/>
        <rdfs:comment xml:lang="es">Indica que un fallo tiene su origen en una condición ambiental específica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a failure is caused by a specific environmental condition.</rdfs:comment>
        <rdfs:label xml:lang="es">Causa de fallo</rdfs:label>
        <rdfs:label xml:lang="en">Failure cause</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasGeneratedData -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasGeneratedData">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#generated"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Data"/>
        <rdfs:comment xml:lang="es">Relaciona un evento con los datos generados por el mismo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an event to the generated data by the same.</rdfs:comment>
        <rdfs:label xml:lang="es">Genera</rdfs:label>
        <rdfs:label xml:lang="en">Generates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasInstalled -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasInstalled">
        <owl:inverseOf rdf:resource="https://w3id.org/optimar#isInstalledIn"/>
