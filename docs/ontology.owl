        <rdfs:label xml:lang="en">Monitors pitch of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#monitorsYawOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#monitorsYawOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#monitors"/>
