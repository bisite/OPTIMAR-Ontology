    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/ns/prov#generated -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#generated">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov#"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasAssociatedWith -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAssociatedWith">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov#"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasInformedBy -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasInformedBy">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov#"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/hasFeatureOfInterest -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasFeatureOfInterest">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/hasResult -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasResult">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/hosts -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hosts">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/isHostedBy -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isHostedBy">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/madeBySensor -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeBySensor">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#actorMonitors -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#actorMonitors">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#monitors"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Actor"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#Component"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#Sensor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relaciona a un actor con los componentes o sensores que supervisa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an actor to the components or sensors they monitor.</rdfs:comment>
        <rdfs:label xml:lang="es">Actor monitorea</rdfs:label>
        <rdfs:label xml:lang="en">Actor monitors</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#addressesFailure -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#addressesFailure">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Maintenance"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:comment xml:lang="es">Relaciona una actividad de mantenimiento con el fallo que corrige o previene.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a maintenance activity with the failure it corrects or prevents.</rdfs:comment>
        <rdfs:label xml:lang="es">Aborda fallo</rdfs:label>
        <rdfs:label xml:lang="en">Addresses failure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#adjusts -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#adjusts">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Actor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Indica que un actor realiza ajustes sobre un componente (p. ej. el sistema de pitch).</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that an actor makes adjustments on a component (e.g. the pitch system).</rdfs:comment>
        <rdfs:label xml:lang="en">Adjusts</rdfs:label>
        <rdfs:label xml:lang="es">Ajusta</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#affectedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#affectedBy">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:comment xml:lang="es">Indica que un componente está afectado por un fallo específico.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a component is affected by a specific failure.</rdfs:comment>
        <rdfs:label xml:lang="es">Afectado por</rdfs:label>
        <rdfs:label xml:lang="en">Affected by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#affects -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#affects">
        <owl:inverseOf rdf:resource="https://w3id.org/optimar#affectedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Indica que un fallo afecta un componente específico.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a failure affects a specific component.</rdfs:comment>
        <rdfs:label xml:lang="es">Afecta</rdfs:label>
        <rdfs:label xml:lang="en">Affects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#analyzes -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#analyzes">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Actor"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#Data"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#Failure"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relaciona a un actor con los datos o fallos que estudia o interpreta.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an actor to the data or failures that it studies or interprets.</rdfs:comment>
        <rdfs:label xml:lang="es">Analiza</rdfs:label>
        <rdfs:label xml:lang="en">Analyzes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#anchorLoad -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#anchorLoad">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Anchor"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Carga de diseño que el ancla debe resistir (capacidad de agarre), expresada como valor QUDT.</rdfs:comment>
        <rdfs:comment xml:lang="en">Design load the anchor must withstand (holding capacity), expressed as a QUDT quantity value.</rdfs:comment>
        <rdfs:label xml:lang="en">Anchor load</rdfs:label>
        <rdfs:label xml:lang="es">Carga del ancla</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#anchoredIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#anchoredIn">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Anchor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Seabed"/>
        <rdfs:comment xml:lang="es">Relaciona un ancla con el fondo marino en el que está instalada.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an anchor with the seabed in which it is installed.</rdfs:comment>
        <rdfs:label xml:lang="en">Anchored in</rdfs:label>
        <rdfs:label xml:lang="es">Anclada en</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#causedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#causedBy">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Event"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:comment xml:lang="es">Relaciona un evento con el fallo que lo provocó.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an event with the failure that caused it.</rdfs:comment>
        <rdfs:label xml:lang="es">Causado por</rdfs:label>
        <rdfs:label xml:lang="en">Caused by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#causesFailure -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#causesFailure">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:comment xml:lang="es">Indica que un fallo causa otro fallo (relación de cascada).</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a failure causes another failure (cascade relationship).</rdfs:comment>
        <rdfs:label xml:lang="es">Causa fallo</rdfs:label>
        <rdfs:label xml:lang="en">Causes failure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#connectedTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#connectedTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Indica que un componente está conectado a otro.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a component is connected to another.</rdfs:comment>
        <rdfs:label xml:lang="es">Conectado a</rdfs:label>
        <rdfs:label xml:lang="en">Connected to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#detectedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#detectedBy">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Event"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:comment xml:lang="es">Relaciona un evento con el sensor que lo detectó.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an event to the sensor that detected it.</rdfs:comment>
        <rdfs:label xml:lang="es">Detectado por</rdfs:label>
        <rdfs:label xml:lang="en">Detected by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#detects -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#detects">
        <owl:inverseOf rdf:resource="https://w3id.org/optimar#detectedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Event"/>
        <rdfs:comment xml:lang="es">Relaciona un sensor con el evento que detecta.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a sensor to the event that it detects.</rdfs:comment>
        <rdfs:label xml:lang="es">Detecta</rdfs:label>
        <rdfs:label xml:lang="en">Detects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#detectsCorrosion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#detectsCorrosion">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Corrosion"/>
        <rdfs:comment xml:lang="es">Relaciona un sensor con la medición de corrosión detectada.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a sensor with the detected corrosion measurement.</rdfs:comment>
        <rdfs:label xml:lang="es">Detecta corrosión</rdfs:label>
        <rdfs:label xml:lang="en">Detects corrosion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#diameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#diameter">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="en">Diameter of the component measured in QUDT units.</rdfs:comment>
        <rdfs:comment xml:lang="es">Diámetro del componente medido en unidades QUDT.</rdfs:comment>
        <rdfs:label xml:lang="en">Diameter</rdfs:label>
        <rdfs:label xml:lang="es">Diámetro</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#displacedVolume -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#displacedVolume">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#FloatingSubstructure"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="en">Volume of water displaced by the floating substructure (hydrostatic displacement), expressed as a QUDT quantity value.</rdfs:comment>
        <rdfs:comment xml:lang="es">Volumen de agua desplazado por la subestructura flotante (desplazamiento hidrostático), expresado como valor QUDT.</rdfs:comment>
        <rdfs:label xml:lang="en">Displaced volume</rdfs:label>
        <rdfs:label xml:lang="es">Volumen desplazado</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#draft -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#draft">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#FloatingSubstructure"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Distancia vertical entre la línea de flotación y el punto más bajo de la subestructura flotante, expresada como valor QUDT.</rdfs:comment>
        <rdfs:comment xml:lang="en">Vertical distance between the waterline and the lowest point of the floating substructure, expressed as a QUDT quantity value.</rdfs:comment>
        <rdfs:label xml:lang="es">Calado</rdfs:label>
        <rdfs:label xml:lang="en">Draft</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#duration -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#duration">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#Event"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#Maintenance"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Duración del evento o mantenimiento expresada como valor QUDT.</rdfs:comment>
        <rdfs:comment xml:lang="en">Duration of the event or maintenance expressed as a QUDT quantity value.</rdfs:comment>
        <rdfs:label xml:lang="es">Duración</rdfs:label>
        <rdfs:label xml:lang="en">Duration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#elasticModulus -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#elasticModulus">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="en">Elastic modulus of the material of a component, expressed as a QUDT quantity value.</rdfs:comment>
        <rdfs:comment xml:lang="es">Módulo de elasticidad del material de un componente, expresado como valor QUDT.</rdfs:comment>
        <rdfs:label xml:lang="en">Elastic modulus</rdfs:label>
        <rdfs:label xml:lang="es">Módulo elástico</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#electricalParameterMonitoredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#electricalParameterMonitoredBy">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#monitoredBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#ElectricalSensor"/>
        <rdfs:comment xml:lang="es">Relaciona un componente con el sensor eléctrico que monitorea sus parámetros.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a component with the electrical sensor that monitors its parameters.</rdfs:comment>
        <rdfs:label xml:lang="en">Electrical parameter monitored by</rdfs:label>
        <rdfs:label xml:lang="es">Parámetro eléctrico monitoreado por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#failureObservation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#failureObservation">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#FailureEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Observation"/>
        <rdfs:comment xml:lang="es">Relación entre un evento de fallo y la observación realizada por un sensor.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relationship between a failure event and the observation made by a sensor.</rdfs:comment>
        <rdfs:label xml:lang="en">Failure observation</rdfs:label>
        <rdfs:label xml:lang="es">Observación de fallo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasAnchor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasAnchor">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#hasMooringComponent"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#MooringSystem"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Anchor"/>
        <rdfs:comment xml:lang="es">Relaciona un sistema de amarre con sus anclas.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a mooring system with its anchors.</rdfs:comment>
        <rdfs:label xml:lang="en">Has anchor</rdfs:label>
        <rdfs:label xml:lang="es">Tiene ancla</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasCapacity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasCapacity">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Turbine"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Capacidad nominal de generación expresada en unidades QUDT (típicamente MW).</rdfs:comment>
        <rdfs:comment xml:lang="en">Nominal generation capacity expressed in QUDT units (typically MW).</rdfs:comment>
        <rdfs:label xml:lang="es">Capacidad nominal</rdfs:label>
        <rdfs:label xml:lang="en">Nominal capacity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasComponent">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#WindPowerPlatform"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Indica que una plataforma eólica offshore tiene un componente específico.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that an offshore wind power platform has a specific component.</rdfs:comment>
        <rdfs:label xml:lang="en">Has component</rdfs:label>
        <rdfs:label xml:lang="es">Tiene componente</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasFailureCause -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasFailureCause">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#EnvironmentalCondition"/>
        <rdfs:comment xml:lang="es">Indica que un fallo tiene su origen en una condición ambiental específica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a failure is caused by a specific environmental condition.</rdfs:comment>
        <rdfs:label xml:lang="es">Causa de fallo</rdfs:label>
        <rdfs:label xml:lang="en">Failure cause</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasGeneratedData -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasGeneratedData">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#generated"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Data"/>
        <rdfs:comment xml:lang="es">Relaciona un evento o actividad con los datos que genera.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an event or activity to the data it generates.</rdfs:comment>
        <rdfs:label xml:lang="es">Genera</rdfs:label>
        <rdfs:label xml:lang="en">Generates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasInstalled -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasInstalled">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/hosts"/>
        <owl:inverseOf rdf:resource="https://w3id.org/optimar#isInstalledIn"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:comment xml:lang="es">Indica que un componente tiene un sensor instalado.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a component has a sensor installed.</rdfs:comment>
        <rdfs:label xml:lang="en">Has installed</rdfs:label>
        <rdfs:label xml:lang="es">Tiene instalado</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasLineDistribution -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasLineDistribution">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#MooringSystem"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#MooringLineDistribution"/>
        <rdfs:comment xml:lang="es">Indica la disposición de las líneas de un sistema de amarre.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates the arrangement of the lines of a mooring system.</rdfs:comment>
        <rdfs:label xml:lang="en">Has line distribution</rdfs:label>
        <rdfs:label xml:lang="es">Tiene distribución de líneas</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasMember -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasMember">
        <owl:inverseOf rdf:resource="https://w3id.org/optimar#isMemberOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#FloatingSubstructure"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#SubstructureMember"/>
        <rdfs:comment xml:lang="es">Relaciona una subestructura flotante con los miembros estructurales que la componen.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a floating substructure with the structural members that compose it.</rdfs:comment>
        <rdfs:label xml:lang="en">Has member</rdfs:label>
        <rdfs:label xml:lang="es">Tiene miembro</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasMooringComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasMooringComponent">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#MooringSystem"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#MooringComponent"/>
        <rdfs:comment xml:lang="es">Relaciona un sistema de amarre con los elementos que lo componen.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a mooring system with the elements that compose it.</rdfs:comment>
        <rdfs:label xml:lang="en">Has mooring component</rdfs:label>
        <rdfs:label xml:lang="es">Tiene componente de amarre</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasMooringLine -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasMooringLine">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#hasMooringComponent"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#MooringSystem"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#MooringLine"/>
        <rdfs:comment xml:lang="es">Relaciona un sistema de amarre con sus líneas de amarre.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a mooring system with its mooring lines.</rdfs:comment>
        <rdfs:label xml:lang="en">Has mooring line</rdfs:label>
        <rdfs:label xml:lang="es">Tiene línea de amarre</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasOperationalState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasOperationalState">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#OperationalState"/>
        <rdfs:comment xml:lang="es">Relaciona un componente con su estado operativo actual.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a component with its current operational state.</rdfs:comment>
        <rdfs:label xml:lang="en">Has operational state</rdfs:label>
        <rdfs:label xml:lang="es">Tiene estado operativo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasPlatform -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasPlatform">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#WindFarm"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#WindPowerPlatform"/>
        <rdfs:comment xml:lang="es">Indica la plataforma eólica asociada a un parque eólico.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates the wind power platform associated with a wind farm.</rdfs:comment>
        <rdfs:label xml:lang="en">Has platform</rdfs:label>
        <rdfs:label xml:lang="es">Tiene plataforma</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasRole -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasRole">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Actor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Role"/>
        <rdfs:comment xml:lang="es">Indica el rol que desempeña un actor dentro del sistema.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates the role that an actor performs within the system.</rdfs:comment>
        <rdfs:label xml:lang="en">Has role</rdfs:label>
        <rdfs:label xml:lang="es">Tiene rol</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasSeabed -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasSeabed">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Location"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Seabed"/>
        <rdfs:comment xml:lang="es">Relaciona una ubicación con las características de su fondo marino.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a location with the characteristics of its seabed.</rdfs:comment>
        <rdfs:label xml:lang="en">Has seabed</rdfs:label>
        <rdfs:label xml:lang="es">Tiene fondo marino</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasTurbine -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasTurbine">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#WindPowerPlatform"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Turbine"/>
        <rdfs:comment xml:lang="es">Indica que una plataforma eólica contiene una turbina eólica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a wind power platform contains a wind turbine.</rdfs:comment>
        <rdfs:label xml:lang="en">Has turbine</rdfs:label>
        <rdfs:label xml:lang="es">Tiene turbina</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasTurbineComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasTurbineComponent">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Turbine"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#TurbineComponent"/>
        <rdfs:comment xml:lang="es">Indica que una turbina tiene un componente de turbina específico.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a turbine has a specific turbine component.</rdfs:comment>
        <rdfs:label xml:lang="en">Has turbine component</rdfs:label>
        <rdfs:label xml:lang="es">Tiene componente de turbina</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#height -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#height">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Altura del componente expresada como un valor con unidad QUDT.</rdfs:comment>
        <rdfs:comment xml:lang="en">Height of the component expressed as a QUDT quantity value.</rdfs:comment>
        <rdfs:label xml:lang="es">Altura</rdfs:label>
        <rdfs:label xml:lang="en">Height</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#houses -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#houses">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Indica que un componente contiene o aloja físicamente a otro en su estructura.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a component contains or houses physically another in its structure.</rdfs:comment>
        <rdfs:label xml:lang="es">Aloja</rdfs:label>
        <rdfs:label xml:lang="en">Houses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#isHousedIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#isHousedIn">
        <owl:inverseOf rdf:resource="https://w3id.org/optimar#houses"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Indica que un componente está físicamente contenido dentro de otro.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a component is physically contained within another.</rdfs:comment>
        <rdfs:label xml:lang="es">Está alojado en</rdfs:label>
        <rdfs:label xml:lang="en">Is housed in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#isInstalledIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#isInstalledIn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/isHostedBy"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Indica que un sensor está instalado en un componente.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a sensor is installed in a component.</rdfs:comment>
        <rdfs:label xml:lang="es">Está instalado en</rdfs:label>
        <rdfs:label xml:lang="en">Is installed in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#isMemberOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#isMemberOf">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#SubstructureMember"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#FloatingSubstructure"/>
        <rdfs:comment xml:lang="es">Relaciona un miembro estructural con la subestructura flotante de la que forma parte.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a structural member with the floating substructure it belongs to.</rdfs:comment>
        <rdfs:label xml:lang="es">Es miembro de</rdfs:label>
        <rdfs:label xml:lang="en">Is member of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#isPartOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#isPartOf">
        <owl:inverseOf rdf:resource="https://w3id.org/optimar#hasTurbineComponent"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#TurbineComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Turbine"/>
        <rdfs:comment xml:lang="es">Indica que un componente de turbina forma parte de una turbina específica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a turbine component is part of a specific turbine.</rdfs:comment>
        <rdfs:label xml:lang="es">Es parte de</rdfs:label>
        <rdfs:label xml:lang="en">Is part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#isSupportedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#isSupportedBy">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Indica que un componente depende estructural o funcionalmente de otro para su soporte.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a component is structurally or functionally supported by another.</rdfs:comment>
        <rdfs:label xml:lang="es">Es soportado por</rdfs:label>
        <rdfs:label xml:lang="en">Is supported by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#length -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#length">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="en">Length of a component, expressed as a QUDT quantity value</rdfs:comment>
        <rdfs:comment xml:lang="es">Longitud de un componente, expresada como un valor con unidad QUDT</rdfs:comment>
        <rdfs:label xml:lang="en">Length</rdfs:label>
        <rdfs:label xml:lang="es">Longitud</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#lineTension -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#lineTension">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#MooringLine"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="en">Design or pretension load of a mooring line, expressed as a QUDT quantity value.</rdfs:comment>
        <rdfs:comment xml:lang="es">Tensión (de diseño o pretensión) de una línea de amarre, expresada como valor QUDT.</rdfs:comment>
        <rdfs:label xml:lang="en">Line tension</rdfs:label>
        <rdfs:label xml:lang="es">Tensión de la línea</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#locatedIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#locatedIn">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#WindPowerPlatform"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Location"/>
        <rdfs:comment xml:lang="es">Indica el lugar en el que se encuentra la plataforma eólica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates the location where the wind power platform is located.</rdfs:comment>
        <rdfs:label xml:lang="en">Located in</rdfs:label>
        <rdfs:label xml:lang="es">Ubicado en</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#madeBySensor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#madeBySensor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/madeBySensor"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:comment xml:lang="es">Relaciona una observación con el sensor que la realizó.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an observation to the sensor that made it.</rdfs:comment>
        <rdfs:label xml:lang="en">Made by sensor</rdfs:label>
        <rdfs:label xml:lang="es">Realizada por sensor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#manages -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#manages">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Actor"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#MooringSystem"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#WindFarm"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#WindPowerPlatform"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Indica que un actor se encarga de la gestión de un parque eólico, una plataforma eólica o su sistema de amarre.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that an actor is responsible for managing a wind farm, a wind power platform or its mooring system.</rdfs:comment>
        <rdfs:label xml:lang="es">Administra</rdfs:label>
        <rdfs:label xml:lang="en">Manages</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#mass -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#mass">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Masa del componente expresada como un valor con unidad QUDT</rdfs:comment>
        <rdfs:comment xml:lang="en">Mass of the component expressed as a QUDT quantity value</rdfs:comment>
        <rdfs:label xml:lang="es">Masa</rdfs:label>
        <rdfs:label xml:lang="en">Mass</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#measures -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#measures">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Data"/>
        <rdfs:comment xml:lang="es">Relaciona un sensor con los datos de medición que produce. Para relacionar un sensor con la entidad supervisada (componente o condición ambiental) se usa monitors.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a sensor with the measurement data it produces. To relate a sensor with the monitored entity (component or environmental condition) use monitors.</rdfs:comment>
        <rdfs:label xml:lang="en">Measures</rdfs:label>
        <rdfs:label xml:lang="es">Mide</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#measuresPitchAngle -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#measuresPitchAngle">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#measures"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#PitchAngleSensor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#PitchAngleData"/>
        <rdfs:comment xml:lang="es">Relaciona un sensor de pitch con los datos de ángulo de pitch que mide.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a pitch sensor with the pitch angle data it measures.</rdfs:comment>
        <rdfs:label xml:lang="en">Measures pitch angle</rdfs:label>
        <rdfs:label xml:lang="es">Mide ángulo de pitch</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#measuresStress -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#measuresStress">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#measures"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#StressData"/>
        <rdfs:comment xml:lang="es">Indica que un sensor mide la tensión ejercida sobre un componente.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a sensor measures the stress exerted on a component.</rdfs:comment>
        <rdfs:label xml:lang="en">Measures stress</rdfs:label>
        <rdfs:label xml:lang="es">Mide tensión</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#measuresTemperatureOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#measuresTemperatureOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#monitors"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#TemperatureSensor"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#Component"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#EnvironmentalCondition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relaciona un sensor de temperatura con el componente o condición ambiental cuya temperatura mide.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a temperature sensor with the component or environmental condition whose temperature it measures.</rdfs:comment>
        <rdfs:label xml:lang="en">Measures temperature of</rdfs:label>
        <rdfs:label xml:lang="es">Mide temperatura de</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#measuresVibration -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#measuresVibration">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#measures"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#VibrationData"/>
        <rdfs:comment xml:lang="es">Indica que un sensor obtiene datos de vibración de un componente.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a sensor collects vibration data from a component.</rdfs:comment>
        <rdfs:label xml:lang="en">Measures vibration</rdfs:label>
        <rdfs:label xml:lang="es">Mide vibración</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#measuresWind -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#measuresWind">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#monitors"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#EnvironmentalCondition"/>
        <rdfs:comment xml:lang="es">Relaciona un sensor con la medición de velocidad o dirección del viento.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a sensor with the measurement of wind speed or direction.</rdfs:comment>
        <rdfs:label xml:lang="en">Measures wind</rdfs:label>
        <rdfs:label xml:lang="es">Mide viento</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#measuresWindDirection -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#measuresWindDirection">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#measures"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Anemometer"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#WindDirectionData"/>
        <rdfs:comment xml:lang="es">Relaciona un anemómetro con los datos de dirección del viento que mide.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an anemometer with the wind direction data it measures.</rdfs:comment>
        <rdfs:label xml:lang="en">Measures wind direction</rdfs:label>
        <rdfs:label xml:lang="es">Mide dirección del viento</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#measuresWindSpeed -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#measuresWindSpeed">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#measures"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Anemometer"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#WindSpeedData"/>
        <rdfs:comment xml:lang="es">Relaciona un anemómetro con los datos de velocidad del viento que mide.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an anemometer with the wind speed data it measures.</rdfs:comment>
        <rdfs:label xml:lang="en">Measures wind speed</rdfs:label>
        <rdfs:label xml:lang="es">Mide velocidad del viento</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#measuresYawAngle -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#measuresYawAngle">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#measures"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#YawSensor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#YawAngleData"/>
        <rdfs:comment xml:lang="es">Relaciona un sensor de yaw con los datos de ángulo de orientación que mide.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a yaw sensor with the yaw angle data it measures.</rdfs:comment>
        <rdfs:label xml:lang="en">Measures yaw angle</rdfs:label>
        <rdfs:label xml:lang="es">Mide ángulo de yaw</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#momentOfInertia -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#momentOfInertia">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="en">Mass moment of inertia of a component about its rotation axis, expressed as a QUDT quantity value.</rdfs:comment>
        <rdfs:comment xml:lang="es">Momento de inercia másico de un componente respecto a su eje de rotación, expresado como valor QUDT.</rdfs:comment>
        <rdfs:label xml:lang="en">Moment of inertia</rdfs:label>
        <rdfs:label xml:lang="es">Momento de inercia</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#monitoredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#monitoredBy">
        <owl:inverseOf rdf:resource="https://w3id.org/optimar#monitors"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#Component"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#EnvironmentalCondition"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#Failure"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#Sensor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#Actor"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#Sensor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relaciona una entidad con la entidad que la monitoriza.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an entity to the entity that monitors it.</rdfs:comment>
        <rdfs:label xml:lang="en">Monitored by</rdfs:label>
        <rdfs:label xml:lang="es">Monitorizado por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#monitors -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#monitors">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#Actor"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#Sensor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#Component"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#EnvironmentalCondition"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#Failure"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#Sensor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">General monitoring relationship between a monitoring entity (sensor or actor) and the monitored entity (component, environmental condition, sensor or failure).</rdfs:comment>
        <rdfs:comment xml:lang="es">Relación general de supervisión entre una entidad supervisora (sensor o actor) y la entidad supervisada (componente, condición ambiental, sensor o fallo).</rdfs:comment>
        <rdfs:label xml:lang="es">Monitorea</rdfs:label>
        <rdfs:label xml:lang="en">Monitors</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#monitorsDeformation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#monitorsDeformation">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#monitors"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Deformation"/>
        <rdfs:comment xml:lang="es">Relaciona un sensor con la deformación estructural que mide o supervisa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a sensor to the structural deformation it measures or monitors.</rdfs:comment>
        <rdfs:label xml:lang="es">Monitorea deformación</rdfs:label>
        <rdfs:label xml:lang="en">Monitors deformation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#monitorsPitchOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#monitorsPitchOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#monitors"/>
        <owl:inverseOf rdf:resource="https://w3id.org/optimar#pitchAngleMonitoredBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#PitchAngleSensor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Blade"/>
        <rdfs:comment xml:lang="es">Relaciona un sensor de pitch con la pala cuyo ángulo monitorea.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a pitch sensor with the blade whose angle it monitors.</rdfs:comment>
        <rdfs:label xml:lang="es">Monitorea pitch de</rdfs:label>
        <rdfs:label xml:lang="en">Monitors pitch of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#monitorsYawOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#monitorsYawOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#monitors"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#YawSensor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Nacelle"/>
        <rdfs:comment xml:lang="es">Relaciona un sensor de yaw con la góndola cuya orientación monitorea.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a yaw sensor with the nacelle whose orientation it monitors.</rdfs:comment>
        <rdfs:label xml:lang="es">Monitorea yaw de</rdfs:label>
        <rdfs:label xml:lang="en">Monitors yaw of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#performedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#performedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/optimar#performsTask"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Task"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Actor"/>
        <rdfs:comment xml:lang="es">Indica que una tarea (incluidas las de mantenimiento) ha sido realizada por un actor.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a task (including maintenance) has been performed by an actor.</rdfs:comment>
        <rdfs:label xml:lang="en">Performed by</rdfs:label>
        <rdfs:label xml:lang="es">Realizado por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#performedMaintenance -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#performedMaintenance">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#performsTask"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Actor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Maintenance"/>
        <rdfs:comment xml:lang="es">Relaciona un actor con el mantenimiento que realiza.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an actor with the maintenance that it performs.</rdfs:comment>
        <rdfs:label xml:lang="en">Performs maintenance</rdfs:label>
        <rdfs:label xml:lang="es">Realiza mantenimiento</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#performsTask -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#performsTask">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Actor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Task"/>
        <rdfs:comment xml:lang="es">Relaciona un actor con una tarea que ejecuta como parte de su rol.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an actor with a task that it performs as part of its role.</rdfs:comment>
        <rdfs:label xml:lang="en">Performs task</rdfs:label>
        <rdfs:label xml:lang="es">Realiza tarea</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#pitchAngleMonitoredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#pitchAngleMonitoredBy">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#monitoredBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Blade"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#PitchAngleSensor"/>
        <rdfs:comment xml:lang="es">Relaciona una pala con el sensor que monitorea su ángulo de pitch.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a blade with the sensor that monitors its pitch angle.</rdfs:comment>
        <rdfs:label xml:lang="en">Pitch angle monitored by</rdfs:label>
        <rdfs:label xml:lang="es">Ángulo de pitch monitoreado por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#precededBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#precededBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:comment xml:lang="es">Indica que un fallo fue precedido temporalmente por otro fallo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a failure was preceded temporally by another failure.</rdfs:comment>
        <rdfs:label xml:lang="en">Preceded by</rdfs:label>
        <rdfs:label xml:lang="es">Precedido por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#pressureLevel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#pressureLevel">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Data"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Presión ejercida sobre un componente.</rdfs:comment>
        <rdfs:comment xml:lang="en">Pressure exerted on a component.</rdfs:comment>
        <rdfs:label xml:lang="es">Nivel de presión</rdfs:label>
        <rdfs:label xml:lang="en">Pressure level</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#relatedToComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#relatedToComponent">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Event"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Component"/>
