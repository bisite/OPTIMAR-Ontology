        <rdfs:label xml:lang="es">Masa</rdfs:label>
        <rdfs:label xml:lang="en">Mass</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#measures -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#measures">
