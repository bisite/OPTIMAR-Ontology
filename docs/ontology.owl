        <rdfs:comment xml:lang="en">Indicates that a sensor collects vibration data from a component.</rdfs:comment>
        <rdfs:label xml:lang="en">Measures vibration</rdfs:label>
        <rdfs:label xml:lang="es">Mide vibración</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#measuresWind -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#measuresWind">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#measures"/>
