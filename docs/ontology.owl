        <rdfs:label xml:lang="en">Length</rdfs:label>
        <rdfs:label xml:lang="es">Longitud</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#locatedIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#locatedIn">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#WindPowerPlatform"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Location"/>
