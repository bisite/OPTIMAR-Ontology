        <rdfs:label xml:lang="en">Measures wind speed</rdfs:label>
        <rdfs:label xml:lang="es">Mide velocidad del viento</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#measuresYawAngle -->


