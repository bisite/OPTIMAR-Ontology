        <rdfs:comment xml:lang="en">Relates a sensor with the measurement of wind speed or direction.</rdfs:comment>
        <rdfs:label xml:lang="en">Measures wind</rdfs:label>
        <rdfs:label xml:lang="es">Mide viento</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#measuresWindDirection -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#measuresWindDirection">
