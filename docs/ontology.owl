        <rdfs:comment xml:lang="en">Relates an event to the platform component that is affected.</rdfs:comment>
        <rdfs:label xml:lang="es">Relacionado con componente</rdfs:label>
        <rdfs:label xml:lang="en">Related to component</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#requiresMaintenance -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#requiresMaintenance">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Maintenance"/>
