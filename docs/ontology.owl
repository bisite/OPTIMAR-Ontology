    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#rotationSpeed">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="en">Angular speed of a component expressed as a QUDT quantity value.</rdfs:comment>
        <rdfs:comment xml:lang="es">Velocidad angular de un componente expresada como un valor con unidad QUDT.</rdfs:comment>
        <rdfs:label xml:lang="en">Rotation speed</rdfs:label>
        <rdfs:label xml:lang="es">Velocidad de rotación</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#rotorParameterMonitoredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#rotorParameterMonitoredBy">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#monitoredBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#RotorSensor"/>
        <rdfs:comment xml:lang="es">Relaciona un componente con el sensor que monitorea los parámetros del rotor.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a component with the sensor that monitors its rotor parameters.</rdfs:comment>
        <rdfs:label xml:lang="es">Parámetro de rotor monitoreado por</rdfs:label>
        <rdfs:label xml:lang="en">Rotor parameter monitored by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#samplingFrequency -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#samplingFrequency">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Frecuencia con la que el sensor genera mediciones, expresada como valor QUDT (p. ej. Hz, o 1 por minuto).</rdfs:comment>
        <rdfs:comment xml:lang="en">Frequency at which the sensor produces measurements, expressed as a QUDT quantity value (e.g. Hz, or 1 per minute).</rdfs:comment>
        <rdfs:label xml:lang="es">Frecuencia de muestreo</rdfs:label>
        <rdfs:label xml:lang="en">Sampling frequency</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#seabedInclination -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#seabedInclination">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Seabed"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Pendiente del fondo marino, expresada como valor QUDT (p. ej. en grados).</rdfs:comment>
        <rdfs:comment xml:lang="en">Slope of the seabed, expressed as a QUDT quantity value (e.g. in degrees).</rdfs:comment>
        <rdfs:label xml:lang="es">Inclinación del fondo</rdfs:label>
        <rdfs:label xml:lang="en">Seabed inclination</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#sedimentThickness -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#sedimentThickness">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Seabed"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Espesor de la capa de sedimentos, expresado como valor QUDT.</rdfs:comment>
        <rdfs:comment xml:lang="en">Thickness of the sediment layer, expressed as a QUDT quantity value.</rdfs:comment>
        <rdfs:label xml:lang="es">Espesor sedimentario</rdfs:label>
        <rdfs:label xml:lang="en">Sediment thickness</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#stiffness -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#stiffness">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Rigidez (p. ej. a flexión) de un componente, expresada como valor QUDT.</rdfs:comment>
        <rdfs:comment xml:lang="en">Stiffness (e.g. bending stiffness) of a component, expressed as a QUDT quantity value.</rdfs:comment>
        <rdfs:label xml:lang="es">Rigidez</rdfs:label>
        <rdfs:label xml:lang="en">Stiffness</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#stressLevel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#stressLevel">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Data"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Nivel de tensión registrado en un componente.</rdfs:comment>
        <rdfs:comment xml:lang="en">Stress level recorded in a component.</rdfs:comment>
        <rdfs:label xml:lang="es">Nivel de tensión</rdfs:label>
        <rdfs:label xml:lang="en">Stress level</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#supports -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#supports">
        <owl:inverseOf rdf:resource="https://w3id.org/optimar#isSupportedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Indica que un componente proporciona soporte estructural o funcional a otro.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a component provides structural or functional support to another.</rdfs:comment>
        <rdfs:label xml:lang="es">Soporta a</rdfs:label>
        <rdfs:label xml:lang="en">Supports</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#temperature -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#temperature">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Data"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Temperatura registrada expresada como un valor con unidad QUDT.</rdfs:comment>
        <rdfs:comment xml:lang="en">Temperature recorded expressed as a QUDT quantity value.</rdfs:comment>
        <rdfs:label xml:lang="es">Temperatura</rdfs:label>
        <rdfs:label xml:lang="en">Temperature</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#temperatureMonitoredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#temperatureMonitoredBy">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#monitoredBy"/>
        <owl:inverseOf rdf:resource="https://w3id.org/optimar#measuresTemperatureOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#Component"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#EnvironmentalCondition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/optimar#TemperatureSensor"/>
        <rdfs:comment xml:lang="es">Relaciona un componente o condición ambiental con el sensor de temperatura que lo monitorea.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a component or environmental condition with the temperature sensor that monitors it.</rdfs:comment>
        <rdfs:label xml:lang="es">Temperatura monitoreada por</rdfs:label>
        <rdfs:label xml:lang="en">Temperature monitored by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#thickness -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#thickness">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Espesor de la sección o pared de un componente medido en unidades QUDT.</rdfs:comment>
        <rdfs:comment xml:lang="en">Thickness of the section or wall of a component measured in QUDT units.</rdfs:comment>
        <rdfs:label xml:lang="es">Espesor</rdfs:label>
        <rdfs:label xml:lang="en">Thickness</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#transmitsMovementTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#transmitsMovementTo">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Indica que un componente transmite movimiento mecánico a otro.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a component transmits mechanical movement to another.</rdfs:comment>
        <rdfs:label xml:lang="es">Transmite movimiento a</rdfs:label>
        <rdfs:label xml:lang="en">Transmits movement to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#transportLoad -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#transportLoad">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Anchor"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Carga a la que se somete el ancla durante su transporte e instalación, expresada como valor QUDT.</rdfs:comment>
        <rdfs:comment xml:lang="en">Load the anchor is subjected to during transport and installation, expressed as a QUDT quantity value.</rdfs:comment>
        <rdfs:label xml:lang="es">Carga de transporte</rdfs:label>
        <rdfs:label xml:lang="en">Transport load</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#triggeredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#triggeredBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasInformedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Maintenance"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Event"/>
        <rdfs:comment xml:lang="es">Relaciona una actividad de mantenimiento con el evento (p. ej. un evento de fallo) que la desencadenó.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a maintenance activity with the event (e.g. a failure event) that triggered it.</rdfs:comment>
        <rdfs:label xml:lang="es">Desencadenado por</rdfs:label>
        <rdfs:label xml:lang="en">Triggered by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#turbineComponentMonitoredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#turbineComponentMonitoredBy">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#monitoredBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#TurbineComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:comment xml:lang="es">Relaciona un componente de turbina con los sensores que lo supervisan.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a turbine component with the sensors that monitor it.</rdfs:comment>
        <rdfs:label xml:lang="es">Es monitoreado por</rdfs:label>
        <rdfs:label xml:lang="en">Is monitored by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#vibrationLevel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#vibrationLevel">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Data"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="en">Level of vibrations recorded in a component or system.</rdfs:comment>
        <rdfs:comment xml:lang="es">Nivel de vibraciones registradas en un componente o sistema.</rdfs:comment>
        <rdfs:label xml:lang="es">Nivel de vibración</rdfs:label>
        <rdfs:label xml:lang="en">Vibration level</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#waterDepth -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#waterDepth">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Location"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Profundidad del agua en la ubicación, expresada como valor QUDT.</rdfs:comment>
        <rdfs:comment xml:lang="en">Water depth at the location, expressed as a QUDT quantity value.</rdfs:comment>
        <rdfs:label xml:lang="es">Profundidad del agua</rdfs:label>
        <rdfs:label xml:lang="en">Water depth</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#width -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#width">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Anchura del componente expresada como un valor con unidad QUDT.</rdfs:comment>
        <rdfs:comment xml:lang="en">Width of the component expressed as a QUDT quantity value.</rdfs:comment>
        <rdfs:label xml:lang="es">Anchura</rdfs:label>
        <rdfs:label xml:lang="en">Width</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#windDirection -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#windDirection">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#EnvironmentalCondition"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Dirección desde la que sopla el viento expresada en valores con unidad QUDT.</rdfs:comment>
        <rdfs:comment xml:lang="en">Direction from which the wind blows expressed as a QUDT quantity value.</rdfs:comment>
        <rdfs:label xml:lang="es">Dirección del viento</rdfs:label>
        <rdfs:label xml:lang="en">Wind direction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#windSpeed -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#windSpeed">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#EnvironmentalCondition"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="es">Velocidad del viento expresada como valor QUDT.</rdfs:comment>
        <rdfs:comment xml:lang="en">Wind speed expressed as a QUDT quantity value.</rdfs:comment>
        <rdfs:label xml:lang="es">Velocidad del viento</rdfs:label>
        <rdfs:label xml:lang="en">Wind speed</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#yawAngleMonitoredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#yawAngleMonitoredBy">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#monitoredBy"/>
        <owl:inverseOf rdf:resource="https://w3id.org/optimar#monitorsYawOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Nacelle"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#YawSensor"/>
        <rdfs:comment xml:lang="es">Relaciona la góndola con el sensor que monitorea su ángulo de orientación.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates the nacelle with the sensor that monitors its yaw angle.</rdfs:comment>
        <rdfs:label xml:lang="en">Yaw angle monitored by</rdfs:label>
        <rdfs:label xml:lang="es">Ángulo de yaw monitoreado por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/ns/sosa/resultTime -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/sosa/resultTime">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#corrosionLevel -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#corrosionLevel">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#CorrosionEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">General corrosion index detected in a component.</rdfs:comment>
        <rdfs:comment xml:lang="es">Índice general de corrosión detectada en un componente.</rdfs:comment>
        <rdfs:label xml:lang="en">Corrosion level</rdfs:label>
        <rdfs:label xml:lang="es">Nivel de corrosión</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#darkCorrosionLevel -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#darkCorrosionLevel">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#corrosionLevel"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#CorrosionEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Level of dark corrosion detected on the material surface.</rdfs:comment>
        <rdfs:comment xml:lang="es">Nivel de corrosión oscura detectada en la superficie del material.</rdfs:comment>
        <rdfs:label xml:lang="en">Dark corrosion level</rdfs:label>
        <rdfs:label xml:lang="es">Nivel de corrosión oscura</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#dataFormat -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#dataFormat">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Sensor"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#Data"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Format in which the sensor delivers its data or in which a data item is serialised (e.g. CSV, TXT, binary, JPG, MP4, JSON, Modbus).</rdfs:comment>
        <rdfs:comment xml:lang="es">Formato en el que el sensor entrega sus datos o en el que está serializado un dato (p. ej. CSV, TXT, binario, JPG, MP4, JSON, Modbus).</rdfs:comment>
        <rdfs:label xml:lang="en">Data format</rdfs:label>
        <rdfs:label xml:lang="es">Formato de datos</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#dateTime -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#dateTime">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Measurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Associated temporal mark to the measurement.</rdfs:comment>
        <rdfs:comment xml:lang="es">Marca temporal asociada a la medición.</rdfs:comment>
        <rdfs:label xml:lang="en">Date and time</rdfs:label>
        <rdfs:label xml:lang="es">Fecha y hora</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#deformationLevel -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#deformationLevel">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Data"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Degree of deformation recorded in the component.</rdfs:comment>
        <rdfs:comment xml:lang="es">Grado de deformación registrado en el componente.</rdfs:comment>
        <rdfs:label xml:lang="en">Deformation level</rdfs:label>
        <rdfs:label xml:lang="es">Nivel de Deformación</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#detectionDateTime -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#detectionDateTime">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Detection timestamp when the failure was detected.</rdfs:comment>
        <rdfs:comment xml:lang="es">Marca temporal de detección del fallo.</rdfs:comment>
        <rdfs:label xml:lang="en">Detection date and time</rdfs:label>
        <rdfs:label xml:lang="es">Fecha y hora de detección</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#displacement -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#displacement">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Data"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="es">Desplazamiento o cambio de posición registrado en el componente.</rdfs:comment>
        <rdfs:comment xml:lang="en">Displacement or position change recorded in the component.</rdfs:comment>
        <rdfs:label xml:lang="es">Desplazamiento</rdfs:label>
        <rdfs:label xml:lang="en">Displacement</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#endDateTime -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#endDateTime">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#Event"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#Maintenance"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">End timestamp of the event or maintenance.</rdfs:comment>
        <rdfs:comment xml:lang="es">Marca temporal de finalización del evento o mantenimiento.</rdfs:comment>
        <rdfs:label xml:lang="en">End date and time</rdfs:label>
        <rdfs:label xml:lang="es">Fecha y hora de finalización</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#externalShape -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#externalShape">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Describe la forma externa o geometría del componente.</rdfs:comment>
        <rdfs:comment xml:lang="en">Describes the external shape or geometry of the component.</rdfs:comment>
        <rdfs:label xml:lang="en">External shape</rdfs:label>
        <rdfs:label xml:lang="es">Forma externa</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#imageURL -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#imageURL">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Image"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Access URL of the generated or stored image.</rdfs:comment>
        <rdfs:comment xml:lang="es">Dirección de acceso a la imagen generada o almacenada.</rdfs:comment>
        <rdfs:label xml:lang="en">Image URL</rdfs:label>
        <rdfs:label xml:lang="es">URL de la imagen</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#lightCorrosion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#lightCorrosion">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#corrosionLevel"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#CorrosionEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Level of light corrosion detected on the material surface.</rdfs:comment>
        <rdfs:comment xml:lang="es">Nivel de corrosión clara detectada en la superficie del material.</rdfs:comment>
        <rdfs:label xml:lang="en">Light corrosion level</rdfs:label>
        <rdfs:label xml:lang="es">Nivel de corrosión clara</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#material -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#material">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Material de fabricación del componente (ej. acero, compuesto, fibra de vidrio, etc.).</rdfs:comment>
        <rdfs:comment xml:lang="en">Material of manufacturing of the component (e.g. steel, composite, fiberglass, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">Material</rdfs:label>
        <rdfs:label xml:lang="es">Material</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#materialFatigue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#materialFatigue">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Data"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Accumulated material fatigue degree.</rdfs:comment>
        <rdfs:comment xml:lang="es">Grado de fatiga acumulada en el material.</rdfs:comment>
        <rdfs:label xml:lang="es">Fatiga material</rdfs:label>
        <rdfs:label xml:lang="en">Material fatigue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#materialWear -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#materialWear">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Data"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Degree of material wear in a component.</rdfs:comment>
        <rdfs:comment xml:lang="es">Grado de desgaste de un material en un componente.</rdfs:comment>
        <rdfs:label xml:lang="es">Desgaste material</rdfs:label>
        <rdfs:label xml:lang="en">Material wear</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#measurementType -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#measurementType">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Measurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Especifica el tipo de medida que representa una observación de medida (por ejemplo, máxima, mínima o media).</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the type of measurement represented by a measurement observation (e.g., maximum, minimum or average).</rdfs:comment>
        <rdfs:label xml:lang="en">Measurement type</rdfs:label>
        <rdfs:label xml:lang="es">Tipo de medición</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#misalignmentLevel -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#misalignmentLevel">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Data"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Measure of the misalignment level detected in a component.</rdfs:comment>
        <rdfs:comment xml:lang="es">Medida del grado de desalineación detectada en un componente.</rdfs:comment>
        <rdfs:label xml:lang="en">Misalignment level</rdfs:label>
        <rdfs:label xml:lang="es">Nivel de desalineación</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#numberOfMooringLines -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#numberOfMooringLines">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#MooringSystem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="es">Número total de líneas de un sistema de amarre.</rdfs:comment>
        <rdfs:comment xml:lang="en">Total number of lines of a mooring system.</rdfs:comment>
        <rdfs:label xml:lang="en">Number of mooring lines</rdfs:label>
        <rdfs:label xml:lang="es">Número de líneas de amarre</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#operationalStatus -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#operationalStatus">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Turbine"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Current operational status of the turbine as free text. Deprecated since v2.4: use hasOperationalState with an OperationalState individual.</rdfs:comment>
        <rdfs:comment xml:lang="es">Estado de funcionamiento actual de la turbina como texto libre. Obsoleta desde la v2.4: usar hasOperationalState con un individuo de OperationalState.</rdfs:comment>
        <rdfs:label xml:lang="es">Estado operativo (texto, obsoleta)</rdfs:label>
        <rdfs:label xml:lang="en">Operational status (text, deprecated)</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/optimar#hasOperationalState"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#reinforcementType -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#reinforcementType">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Descripción de la estructura interna de refuerzo de un componente (p. ej. larguero de fibra de carbono en la pala).</rdfs:comment>
        <rdfs:comment xml:lang="en">Description of the internal reinforcement structure of a component (e.g. carbon fibre spar cap in the blade).</rdfs:comment>
        <rdfs:label xml:lang="en">Reinforcement type</rdfs:label>
        <rdfs:label xml:lang="es">Tipo de refuerzo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#severity -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#severity">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Nivel de severidad del fallo: &apos;low&apos;, &apos;medium&apos;, &apos;high&apos;, &apos;critical&apos;.</rdfs:comment>
        <rdfs:comment xml:lang="en">Severity level of the failure: &apos;low&apos;, &apos;medium&apos;, &apos;high&apos;, &apos;critical&apos;.</rdfs:comment>
        <rdfs:label xml:lang="es">Severidad</rdfs:label>
        <rdfs:label xml:lang="en">Severity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#soilComposition -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#soilComposition">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Seabed"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Tipo o composición del suelo marino (p. ej. arcilla, arena, roca).</rdfs:comment>
        <rdfs:comment xml:lang="en">Type or composition of the seabed soil (e.g. clay, sand, rock).</rdfs:comment>
        <rdfs:label xml:lang="es">Composición del suelo</rdfs:label>
        <rdfs:label xml:lang="en">Soil composition</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#startDateTime -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#startDateTime">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#Event"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#Maintenance"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="es">Marca temporal de inicio del evento o mantenimiento.</rdfs:comment>
        <rdfs:comment xml:lang="en">Start timestamp of the event or maintenance.</rdfs:comment>
        <rdfs:label xml:lang="es">Fecha y hora de inicio</rdfs:label>
        <rdfs:label xml:lang="en">Start date and time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#unit -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#unit">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Measurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Measurement unit of the recorded value (e.g. m/s, rpm, °C, etc.).</rdfs:comment>
        <rdfs:comment xml:lang="es">Unidad de medida del valor registrado (ej. m/s, rpm, °C, etc.).</rdfs:comment>
        <rdfs:label xml:lang="es">Unidad</rdfs:label>
        <rdfs:label xml:lang="en">Unit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/optimar#value -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/optimar#value">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Measurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Numeric value of the measurement taken by a sensor.</rdfs:comment>
        <rdfs:comment xml:lang="es">Valor numérico de la medición tomada por un sensor.</rdfs:comment>
        <rdfs:label xml:lang="es">Valor</rdfs:label>
        <rdfs:label xml:lang="en">Value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://qudt.org/schema/qudt/QuantityValue -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/QuantityValue">
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt/"/>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Activity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Activity">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov#"/>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Agent -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Agent">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov#"/>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Entity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov#"/>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/sosa/FeatureOfInterest -->


    <owl:Class rdf:about="http://www.w3.org/ns/sosa/FeatureOfInterest">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/sosa/Observation -->


    <owl:Class rdf:about="http://www.w3.org/ns/sosa/Observation">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/sosa/Result -->


    <owl:Class rdf:about="http://www.w3.org/ns/sosa/Result">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/sosa/Sensor -->


    <owl:Class rdf:about="http://www.w3.org/ns/sosa/Sensor">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#ActivePowerSensor -->


    <owl:Class rdf:about="https://w3id.org/optimar#ActivePowerSensor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#ElectricalSensor"/>
        <rdfs:comment xml:lang="es">Sensor que mide la potencia activa generada o consumida.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sensor that measures the active power generated or consumed.</rdfs:comment>
        <rdfs:label xml:lang="en">Active power sensor</rdfs:label>
        <rdfs:label xml:lang="es">Sensor de potencia activa</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Actor -->


    <owl:Class rdf:about="https://w3id.org/optimar#Actor">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">An actor that interacts or manages the offshore wind power platform.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un actor que interactúa o gestiona la plataforma eólica.</rdfs:comment>
        <rdfs:label xml:lang="en">Actor</rdfs:label>
        <rdfs:label xml:lang="es">Actor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#AnalyticalRole -->


    <owl:Class rdf:about="https://w3id.org/optimar#AnalyticalRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Role"/>
        <rdfs:comment xml:lang="es">Rol orientado al análisis de datos y generación de información útil para la toma de decisiones.</rdfs:comment>
        <rdfs:comment xml:lang="en">Role focused on data analysis and generation of useful information for decision-making.</rdfs:comment>
        <rdfs:label xml:lang="en">Analytical Role</rdfs:label>
        <rdfs:label xml:lang="es">Rol analítico</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Anchor -->


    <owl:Class rdf:about="https://w3id.org/optimar#Anchor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#MooringComponent"/>
        <rdfs:comment xml:lang="en">Element that fixes a mooring line to the seabed and transfers the mooring loads to the soil.</rdfs:comment>
        <rdfs:comment xml:lang="es">Elemento que fija una línea de amarre al fondo marino y transmite las cargas de amarre al suelo.</rdfs:comment>
        <rdfs:label xml:lang="en">Anchor</rdfs:label>
        <rdfs:label xml:lang="es">Ancla</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Anemometer -->


    <owl:Class rdf:about="https://w3id.org/optimar#Anemometer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:comment xml:lang="es">Sensor que mide la velocidad y dirección del viento en el parque eólico.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sensor that measures wind speed and direction in the wind farm.</rdfs:comment>
        <rdfs:label xml:lang="en">Anemometer</rdfs:label>
        <rdfs:label xml:lang="es">Anemómetro</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#ApparentPowerSensor -->


    <owl:Class rdf:about="https://w3id.org/optimar#ApparentPowerSensor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#ElectricalSensor"/>
        <rdfs:comment xml:lang="es">Sensor que mide la potencia aparente del sistema eléctrico.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sensor that measures the apparent power of the electrical system.</rdfs:comment>
        <rdfs:label xml:lang="en">Apparent power sensor</rdfs:label>
        <rdfs:label xml:lang="es">Sensor de potencia aparente</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Base -->


    <owl:Class rdf:about="https://w3id.org/optimar#Base">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#StructuralComponent"/>
        <rdfs:comment xml:lang="es">Elemento de transición entre la torre y la subestructura flotante que transmite las cargas de la turbina a la estructura flotante.</rdfs:comment>
        <rdfs:comment xml:lang="en">Transition element between the tower and the floating substructure that transmits the turbine loads to the floating structure.</rdfs:comment>
        <rdfs:label xml:lang="es">Base (pieza de transición)</rdfs:label>
        <rdfs:label xml:lang="en">Base (transition piece)</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Blade -->


    <owl:Class rdf:about="https://w3id.org/optimar#Blade">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#TurbineComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/optimar#connectedTo"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/optimar#Hub"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Las palas de la turbina que capturan la energía eólica.</rdfs:comment>
        <rdfs:comment xml:lang="en">The blades of the turbine that capture the wind energy.</rdfs:comment>
        <rdfs:label xml:lang="en">Blade</rdfs:label>
        <rdfs:label xml:lang="es">Pala</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Brace -->


    <owl:Class rdf:about="https://w3id.org/optimar#Brace">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#SubstructureMember"/>
        <rdfs:comment xml:lang="es">Elemento tubular que conecta las columnas de la subestructura flotante y transmite cargas entre ellas.</rdfs:comment>
        <rdfs:comment xml:lang="en">Tubular element that connects the columns of the floating substructure and transfers loads between them.</rdfs:comment>
        <rdfs:label xml:lang="en">Brace</rdfs:label>
        <rdfs:label xml:lang="es">Riostra</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#CatenaryMooringSystem -->


    <owl:Class rdf:about="https://w3id.org/optimar#CatenaryMooringSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#MooringSystem"/>
        <rdfs:comment xml:lang="en">Mooring system whose lines hang in a catenary shape and reach the seabed horizontally; the restoring force comes mainly from the line weight.</rdfs:comment>
        <rdfs:comment xml:lang="es">Sistema de amarre cuyas líneas adoptan forma de catenaria y llegan al fondo de forma horizontal; la fuerza de restauración procede principalmente del peso de las líneas.</rdfs:comment>
        <rdfs:label xml:lang="en">Catenary Mooring System</rdfs:label>
        <rdfs:label xml:lang="es">Sistema de amarre en catenaria</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#CloudAdministrator -->


    <owl:Class rdf:about="https://w3id.org/optimar#CloudAdministrator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Actor"/>
        <rdfs:comment xml:lang="es">Responsable de la administración y seguridad de los servicios en la nube que procesan los datos de la plataforma.</rdfs:comment>
        <rdfs:comment xml:lang="en">Responsible for managing and securing cloud services that process data from the platform.</rdfs:comment>
        <rdfs:label xml:lang="es">Administrador de nube</rdfs:label>
        <rdfs:label xml:lang="en">Cloud Administrator</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Column -->


    <owl:Class rdf:about="https://w3id.org/optimar#Column">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#SubstructureMember"/>
        <rdfs:comment xml:lang="es">Elemento vertical de flotación de una subestructura flotante que aporta flotabilidad y estabilidad hidrostática.</rdfs:comment>
        <rdfs:comment xml:lang="en">Vertical buoyant element of a floating substructure that provides buoyancy and hydrostatic stability.</rdfs:comment>
        <rdfs:label xml:lang="en">Column</rdfs:label>
        <rdfs:label xml:lang="es">Columna</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Component -->


    <owl:Class rdf:about="https://w3id.org/optimar#Component">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment xml:lang="en">A component of an offshore wind power platform, such as blades, towers, pitch system, etc.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un componente de una plataforma eólica offshore, como las palas, torres, sistema de pitch, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">Component</rdfs:label>
        <rdfs:label xml:lang="es">Componente</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#ComponentBreakage -->


    <owl:Class rdf:about="https://w3id.org/optimar#ComponentBreakage">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:comment xml:lang="en">Failure caused by the fracture or breakage of an offshore wind platform component.</rdfs:comment>
        <rdfs:comment xml:lang="es">Fallo originado por la fractura o rotura de un componente de la plataforma eólica.</rdfs:comment>
        <rdfs:label xml:lang="en">Component Breakage</rdfs:label>
        <rdfs:label xml:lang="es">Rotura de componente</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Corrosion -->


    <owl:Class rdf:about="https://w3id.org/optimar#Corrosion">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:comment xml:lang="en">Failure caused by corrosion of the metallic structure of the platform.</rdfs:comment>
        <rdfs:comment xml:lang="es">Fallo causado por la corrosión de la estructura metálica de la plataforma.</rdfs:comment>
        <rdfs:label xml:lang="en">Corrosion</rdfs:label>
        <rdfs:label xml:lang="es">Corrosión</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#CorrosionCamera -->


    <owl:Class rdf:about="https://w3id.org/optimar#CorrosionCamera">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:comment xml:lang="en">Camera used to detect and monitor corrosion in the platform structure.</rdfs:comment>
        <rdfs:comment xml:lang="es">Cámara utilizada para detectar y monitorear corrosión en la estructura de la plataforma.</rdfs:comment>
        <rdfs:label xml:lang="en">Corrosion Camera</rdfs:label>
        <rdfs:label xml:lang="es">Cámara corrosión</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#CorrosionEvent -->


    <owl:Class rdf:about="https://w3id.org/optimar#CorrosionEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#FailureEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/optimar#causedBy"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/optimar#Corrosion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Event in which degradation of the platform&apos;s metallic structure due to corrosion is detected.</rdfs:comment>
        <rdfs:comment xml:lang="es">Evento en el que se detecta la degradación de la estructura metálica de la plataforma por efectos de corrosión.</rdfs:comment>
        <rdfs:label xml:lang="en">Corrosion Event</rdfs:label>
        <rdfs:label xml:lang="es">Evento de detección de corrosión</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#CurrentData -->


    <owl:Class rdf:about="https://w3id.org/optimar#CurrentData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#ElectricalData"/>
        <rdfs:comment xml:lang="es">Datos de corriente eléctrica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Electrical current data.</rdfs:comment>
        <rdfs:label xml:lang="en">Current Data</rdfs:label>
        <rdfs:label xml:lang="es">Datos de corriente</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#CurrentSensor -->


    <owl:Class rdf:about="https://w3id.org/optimar#CurrentSensor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#ElectricalSensor"/>
        <rdfs:comment xml:lang="es">Sensor que mide la corriente eléctrica del motor o generador.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sensor that measures electrical current of the motor or generator.</rdfs:comment>
        <rdfs:label xml:lang="en">Current sensor</rdfs:label>
        <rdfs:label xml:lang="es">Sensor de corriente</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Data -->


    <owl:Class rdf:about="https://w3id.org/optimar#Data">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Result"/>
        <rdfs:comment xml:lang="en">A class for representing the measurement data collected by sensors or other systems.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una clase general para representar los datos de medición recolectados por sensores u otros sistemas.</rdfs:comment>
        <rdfs:label xml:lang="en">Data</rdfs:label>
        <rdfs:label xml:lang="es">Dato</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#DataAnalyst -->


    <owl:Class rdf:about="https://w3id.org/optimar#DataAnalyst">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Actor"/>
        <rdfs:comment xml:lang="es">Especialista que analiza los datos recolectados para detectar patrones, fallos y oportunidades de optimización.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specialist who analyzes collected data to detect patterns, failures, and optimization opportunities.</rdfs:comment>
        <rdfs:label xml:lang="es">Analista de datos</rdfs:label>
        <rdfs:label xml:lang="en">Data Analyst</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#DeadWeightAnchor -->


    <owl:Class rdf:about="https://w3id.org/optimar#DeadWeightAnchor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Anchor"/>
        <rdfs:comment xml:lang="en">Anchor that resists loads mainly through its own weight and friction with the seabed.</rdfs:comment>
        <rdfs:comment xml:lang="es">Ancla que resiste las cargas principalmente por su propio peso y la fricción con el fondo marino.</rdfs:comment>
        <rdfs:label xml:lang="es">Ancla de peso muerto</rdfs:label>
        <rdfs:label xml:lang="en">Dead Weight Anchor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Deformation -->


    <owl:Class rdf:about="https://w3id.org/optimar#Deformation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:comment xml:lang="en">Failure caused by structural deformation of a component.</rdfs:comment>
        <rdfs:comment xml:lang="es">Fallo causado por la deformación estructural de un componente.</rdfs:comment>
        <rdfs:label xml:lang="es">Deformación estructural</rdfs:label>
        <rdfs:label xml:lang="en">Structural deformation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#DragEmbedmentAnchor -->


    <owl:Class rdf:about="https://w3id.org/optimar#DragEmbedmentAnchor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Anchor"/>
        <rdfs:comment xml:lang="en">Anchor installed by dragging it along the seabed until it penetrates the soil.</rdfs:comment>
        <rdfs:comment xml:lang="es">Ancla que se instala arrastrándola sobre el fondo hasta que penetra en el suelo.</rdfs:comment>
        <rdfs:label xml:lang="es">Ancla de arrastre (DEA)</rdfs:label>
        <rdfs:label xml:lang="en">Drag Embedment Anchor (DEA)</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#DrivenPileAnchor -->


    <owl:Class rdf:about="https://w3id.org/optimar#DrivenPileAnchor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Anchor"/>
        <rdfs:comment xml:lang="es">Pilote tubular hincado en el fondo marino mediante martillo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Tubular pile driven into the seabed by hammering.</rdfs:comment>
        <rdfs:label xml:lang="en">Driven Pile Anchor</rdfs:label>
        <rdfs:label xml:lang="es">Pilote hincado</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#DynamicMonitor -->


    <owl:Class rdf:about="https://w3id.org/optimar#DynamicMonitor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:comment xml:lang="en">Device that measures dynamic parameters of the platform, such as vibrations and movements.</rdfs:comment>
        <rdfs:comment xml:lang="es">Dispositivo que mide parámetros dinámicos de la plataforma como vibraciones y movimientos.</rdfs:comment>
        <rdfs:label xml:lang="en">Dynamic Monitor</rdfs:label>
        <rdfs:label xml:lang="es">Monitor dinámico</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#ElectricalData -->


    <owl:Class rdf:about="https://w3id.org/optimar#ElectricalData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Measurement"/>
        <rdfs:comment xml:lang="es">Datos de parámetros eléctricos medidos por un sensor.</rdfs:comment>
        <rdfs:comment xml:lang="en">Electrical parameter data measured by a sensor.</rdfs:comment>
        <rdfs:label xml:lang="es">Datos eléctricos</rdfs:label>
        <rdfs:label xml:lang="en">Electrical Data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#ElectricalSensor -->


    <owl:Class rdf:about="https://w3id.org/optimar#ElectricalSensor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:comment xml:lang="es">Sensor que mide parámetros eléctricos de la turbina.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sensor that measures electrical parameters of the turbine.</rdfs:comment>
        <rdfs:label xml:lang="en">Electrical sensor</rdfs:label>
        <rdfs:label xml:lang="es">Sensor eléctrico</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#EnvironmentalCondition -->


    <owl:Class rdf:about="https://w3id.org/optimar#EnvironmentalCondition">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment xml:lang="es">Las condiciones ambientales que afectan a la plataforma eólica, como la velocidad del viento, la temperatura, etc.</rdfs:comment>
        <rdfs:comment xml:lang="en">The environmental conditions that affect the offshore wind power platform, such as wind speed, temperature, etc.</rdfs:comment>
        <rdfs:label xml:lang="es">Condición ambiental</rdfs:label>
        <rdfs:label xml:lang="en">Environmental Condition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Event -->


    <owl:Class rdf:about="https://w3id.org/optimar#Event">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <owl:disjointWith rdf:resource="https://w3id.org/optimar#Failure"/>
        <owl:disjointWith rdf:resource="https://w3id.org/optimar#Task"/>
        <rdfs:comment xml:lang="en">An event that occurs in the offshore wind power platform, such as a failure detection.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un evento que ocurre en la plataforma eólica, como la detección de un fallo.</rdfs:comment>
        <rdfs:label xml:lang="en">Event</rdfs:label>
        <rdfs:label xml:lang="es">Evento</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Failure -->


    <owl:Class rdf:about="https://w3id.org/optimar#Failure">
        <rdfs:comment xml:lang="en">A class that represents identified failures in the wind platform.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una clase que representa fallos identificados en la plataforma eólica.</rdfs:comment>
        <rdfs:label xml:lang="en">Failure</rdfs:label>
        <rdfs:label xml:lang="es">Fallo</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#FailureEvent -->


    <owl:Class rdf:about="https://w3id.org/optimar#FailureEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Event"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/optimar#causedBy"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/optimar#Failure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Event that represents a detected failure in the system, must be caused by at least one failure.</rdfs:comment>
        <rdfs:comment xml:lang="es">Evento que representa un fallo detectado en el sistema, debe estar causado por al menos un fallo. </rdfs:comment>
        <rdfs:label xml:lang="es">Evento de fallo</rdfs:label>
        <rdfs:label xml:lang="en">Failure Event</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Fairlead -->


    <owl:Class rdf:about="https://w3id.org/optimar#Fairlead">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#MooringComponent"/>
        <rdfs:comment xml:lang="en">Connection point between a mooring line and the floating substructure.</rdfs:comment>
        <rdfs:comment xml:lang="es">Punto de conexión entre una línea de amarre y la subestructura flotante.</rdfs:comment>
        <rdfs:label xml:lang="en">Fairlead</rdfs:label>
        <rdfs:label xml:lang="es">Fairlead</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#FloatingPlatform -->


    <owl:Class rdf:about="https://w3id.org/optimar#FloatingPlatform">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#WindPowerPlatform"/>
        <rdfs:comment xml:lang="en">An offshore wind power platform that includes a turbine, floating substructure, and mooring system</rdfs:comment>
        <rdfs:comment xml:lang="es">Plataforma eólica offshore completa que incluye turbina, subestructura flotante y sistema de amarre.</rdfs:comment>
        <rdfs:label xml:lang="en">Floating Wind Power Platform</rdfs:label>
        <rdfs:label xml:lang="es">Plataforma eólica flotante</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#FloatingSubstructure -->


    <owl:Class rdf:about="https://w3id.org/optimar#FloatingSubstructure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#StructuralComponent"/>
        <rdfs:comment xml:lang="es">La estructura sumergida que proporciona flotabilidad (spar, semi-sumergible, TLP, etc.)</rdfs:comment>
        <rdfs:comment xml:lang="en">The submerged structure that provides buoyancy and stability (spar, semi-submersible, TLP, etc.)</rdfs:comment>
        <rdfs:label xml:lang="en">Floating Substructure</rdfs:label>
        <rdfs:label xml:lang="es">Subestructura flotante</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#FrequencyData -->


    <owl:Class rdf:about="https://w3id.org/optimar#FrequencyData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#ElectricalData"/>
        <rdfs:comment xml:lang="es">Datos de frecuencia de red eléctrica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Electrical grid frequency data.</rdfs:comment>
        <rdfs:label xml:lang="es">Datos de frecuencia</rdfs:label>
        <rdfs:label xml:lang="en">Frequency Data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#GaugeSystem -->


    <owl:Class rdf:about="https://w3id.org/optimar#GaugeSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:comment xml:lang="es">Sistema de galgas extensiométricas utilizado para medir tensiones y deformaciones en la estructura.</rdfs:comment>
        <rdfs:comment xml:lang="en">Strain gauge system used to measure stresses and deformations in the structure.</rdfs:comment>
        <rdfs:label xml:lang="en">Gauge System</rdfs:label>
        <rdfs:label xml:lang="es">Sistema de galgas</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Gearbox -->


    <owl:Class rdf:about="https://w3id.org/optimar#Gearbox">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Sistema de transmisión que ajusta la velocidad de rotación entre el rotor y el generador.</rdfs:comment>
        <rdfs:comment xml:lang="en">Transmission system that adjusts the rotation speed between the rotor and the generator.</rdfs:comment>
        <rdfs:label xml:lang="es">Caja de cambios</rdfs:label>
        <rdfs:label xml:lang="en">Gearbox</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Generator -->


    <owl:Class rdf:about="https://w3id.org/optimar#Generator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="en">Electrical generator that converts mechanical energy into electrical energy.</rdfs:comment>
        <rdfs:comment xml:lang="es">Generador eléctrico que convierte energía mecánica en eléctrica.</rdfs:comment>
        <rdfs:label xml:lang="es">Generador</rdfs:label>
        <rdfs:label xml:lang="en">Generator</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#GravityInstalledAnchor -->


    <owl:Class rdf:about="https://w3id.org/optimar#GravityInstalledAnchor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Anchor"/>
        <rdfs:comment xml:lang="es">Ancla en forma de torpedo que penetra en el fondo marino por caída libre.</rdfs:comment>
        <rdfs:comment xml:lang="en">Torpedo-shaped anchor that penetrates the seabed by free fall.</rdfs:comment>
        <rdfs:label xml:lang="es">Ancla instalada por gravedad</rdfs:label>
        <rdfs:label xml:lang="en">Gravity Installed Anchor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#GridFrequencySensor -->


    <owl:Class rdf:about="https://w3id.org/optimar#GridFrequencySensor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#ElectricalSensor"/>
        <rdfs:comment xml:lang="es">Sensor que mide la frecuencia de la red eléctrica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sensor that measures grid electrical frequency.</rdfs:comment>
        <rdfs:label xml:lang="en">Grid frequency sensor</rdfs:label>
        <rdfs:label xml:lang="es">Sensor de frecuencia de la red</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#HeavePlate -->


    <owl:Class rdf:about="https://w3id.org/optimar#HeavePlate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#SubstructureMember"/>
        <rdfs:comment xml:lang="en">Horizontal plate at the bottom of the columns that increases added mass and damping of the heave motion.</rdfs:comment>
        <rdfs:comment xml:lang="es">Placa horizontal situada en la parte inferior de las columnas que aumenta la masa añadida y el amortiguamiento del movimiento de arfada.</rdfs:comment>
        <rdfs:label xml:lang="en">Heave Plate</rdfs:label>
        <rdfs:label xml:lang="es">Placa de arfada</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Hub -->


    <owl:Class rdf:about="https://w3id.org/optimar#Hub">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#TurbineComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/optimar#connectedTo"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/optimar#Blade"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/optimar#transmitsMovementTo"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/optimar#Generator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">La parte central de la turbina donde se conectan las palas.</rdfs:comment>
        <rdfs:comment xml:lang="en">The central part of the turbine where the blades are connected.</rdfs:comment>
        <rdfs:label xml:lang="en">Hub</rdfs:label>
        <rdfs:label xml:lang="es">Hub</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#ISUMSystem -->


    <owl:Class rdf:about="https://w3id.org/optimar#ISUMSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:comment xml:lang="es">Sistema especializado para la monitorización integrada de la plataforma offshore.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specialized system for integrated monitoring of the offshore platform.</rdfs:comment>
        <rdfs:label xml:lang="en">ISUM System</rdfs:label>
        <rdfs:label xml:lang="es">Sistema ISUM</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Image -->


    <owl:Class rdf:about="https://w3id.org/optimar#Image">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Data"/>
        <rdfs:comment xml:lang="en">A class that represents an image that supports the measurement.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una clase que representa una imagen que soporta la medición.</rdfs:comment>
        <rdfs:label xml:lang="en">Image</rdfs:label>
        <rdfs:label xml:lang="es">Imagen</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Inverter -->


    <owl:Class rdf:about="https://w3id.org/optimar#Inverter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Componente electrónico de potencia que convierte la energía eléctrica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Power electronic component that converts electrical power.</rdfs:comment>
        <rdfs:label xml:lang="es">Inversor</rdfs:label>
        <rdfs:label xml:lang="en">Inverter</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Location -->


    <owl:Class rdf:about="https://w3id.org/optimar#Location">
        <rdfs:comment xml:lang="es">La ubicación geográfica de la plataforma eólica.</rdfs:comment>
        <rdfs:comment xml:lang="en">The geographic location of the wind platform.</rdfs:comment>
        <rdfs:label xml:lang="en">Location</rdfs:label>
        <rdfs:label xml:lang="es">Ubicación</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Maintenance -->


    <owl:Class rdf:about="https://w3id.org/optimar#Maintenance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Task"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/optimar#performedBy"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/optimar#MaintenanceOperator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A class that represents the maintenance of the wind platform.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una clase que representa el mantenimiento de la plataforma eólica.</rdfs:comment>
        <rdfs:label xml:lang="en">Maintenance</rdfs:label>
        <rdfs:label xml:lang="es">Mantenimiento</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#MaintenanceOperator -->


    <owl:Class rdf:about="https://w3id.org/optimar#MaintenanceOperator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Actor"/>
        <rdfs:comment xml:lang="en">Person responsible for carrying out preventive and corrective maintenance on the platform.</rdfs:comment>
        <rdfs:comment xml:lang="es">Persona encargada de realizar el mantenimiento preventivo y correctivo en la plataforma.</rdfs:comment>
        <rdfs:label xml:lang="en">Maintenance Operator</rdfs:label>
        <rdfs:label xml:lang="es">Operador de mantenimiento</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#ManagementRole -->


    <owl:Class rdf:about="https://w3id.org/optimar#ManagementRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Role"/>
        <rdfs:comment xml:lang="es">Rol encargado de la coordinación, planificación y gestión de recursos en la plataforma eólica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Role responsible for coordination, planning, and resource management in the wind platform.</rdfs:comment>
        <rdfs:label xml:lang="en">Management Role</rdfs:label>
        <rdfs:label xml:lang="es">Rol de gestión</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#MaterialFatigue -->


    <owl:Class rdf:about="https://w3id.org/optimar#MaterialFatigue">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:comment xml:lang="es">Fallo en el material estructural causado por ciclos repetidos de carga.</rdfs:comment>
        <rdfs:comment xml:lang="en">Structural material failure caused by repeated load cycles.</rdfs:comment>
        <rdfs:label xml:lang="es">Fatiga del material</rdfs:label>
        <rdfs:label xml:lang="en">Material Fatigue</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Measurement -->


    <owl:Class rdf:about="https://w3id.org/optimar#Measurement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Data"/>
        <rdfs:comment xml:lang="es">Representa una medición tomada por un sensor.</rdfs:comment>
        <rdfs:comment xml:lang="en">Represents a measurement taken by a sensor.</rdfs:comment>
        <rdfs:label xml:lang="en">Measurement</rdfs:label>
        <rdfs:label xml:lang="es">Medición</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Misalignment -->


    <owl:Class rdf:about="https://w3id.org/optimar#Misalignment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:comment xml:lang="en">Failure caused by misalignment or lack of proper adjustment between platform components.</rdfs:comment>
        <rdfs:comment xml:lang="es">Fallo causado por el desajuste o falta de alineación entre los componentes de la plataforma.</rdfs:comment>
        <rdfs:label xml:lang="es">Desalineación</rdfs:label>
        <rdfs:label xml:lang="en">Misalignment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#MonitoringTask -->


    <owl:Class rdf:about="https://w3id.org/optimar#MonitoringTask">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Task"/>
        <rdfs:comment xml:lang="en">A task aimed at supervising the condition of the platform through sensors and monitoring systems.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una tarea destinada a supervisar el estado de la plataforma mediante sensores y sistemas de monitorización.</rdfs:comment>
        <rdfs:label xml:lang="en">Monitoring Task</rdfs:label>
        <rdfs:label xml:lang="es">Tarea de monitoreo</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#MooringComponent -->


    <owl:Class rdf:about="https://w3id.org/optimar#MooringComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="en">Element that is part of a mooring system (lines, anchors, connectors, tensioners, fairleads).</rdfs:comment>
        <rdfs:comment xml:lang="es">Elemento que forma parte de un sistema de amarre (líneas, anclas, conectores, tensores, fairleads).</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de amarre</rdfs:label>
        <rdfs:label xml:lang="en">Mooring Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#MooringConnector -->


    <owl:Class rdf:about="https://w3id.org/optimar#MooringConnector">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#MooringComponent"/>
        <rdfs:comment xml:lang="es">Elemento de unión entre tramos de línea de amarre o entre la línea y el ancla (grilletes, eslabones, etc.).</rdfs:comment>
        <rdfs:comment xml:lang="en">Joining element between mooring line segments or between the line and the anchor (shackles, links, etc.).</rdfs:comment>
        <rdfs:label xml:lang="es">Conector de amarre</rdfs:label>
        <rdfs:label xml:lang="en">Mooring Connector</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#MooringLine -->


    <owl:Class rdf:about="https://w3id.org/optimar#MooringLine">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#MooringComponent"/>
        <rdfs:comment xml:lang="es">Cadena, cable o cabo sintético que une la subestructura flotante con el ancla.</rdfs:comment>
        <rdfs:comment xml:lang="en">Chain, wire rope or synthetic rope that connects the floating substructure with the anchor.</rdfs:comment>
        <rdfs:label xml:lang="es">Línea de amarre</rdfs:label>
        <rdfs:label xml:lang="en">Mooring Line</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#MooringLineDistribution -->


    <owl:Class rdf:about="https://w3id.org/optimar#MooringLineDistribution">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#ClusteredDistribution"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#EvenlyDistributed"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#SinglePointDistribution"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="es">Disposición geométrica de las líneas de amarre alrededor de la plataforma.</rdfs:comment>
        <rdfs:comment xml:lang="en">Geometric arrangement of the mooring lines around the platform.</rdfs:comment>
        <rdfs:label xml:lang="es">Distribución de líneas de amarre</rdfs:label>
        <rdfs:label xml:lang="en">Mooring Line Distribution</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#MooringSystem -->


    <owl:Class rdf:about="https://w3id.org/optimar#MooringSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#StructuralComponent"/>
        <rdfs:comment xml:lang="es">El sistema de amarre que mantiene la plataforma flotante en su ubicación.</rdfs:comment>
        <rdfs:comment xml:lang="en">The mooring system that keeps the floating platform in place.</rdfs:comment>
        <rdfs:label xml:lang="en">Mooring System</rdfs:label>
        <rdfs:label xml:lang="es">Sistema de amarre</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Nacelle -->


    <owl:Class rdf:about="https://w3id.org/optimar#Nacelle">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#TurbineComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/optimar#houses"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/optimar#Generator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/optimar#isSupportedBy"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/optimar#Tower"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">El compartimento de la turbina que aloja el generador y otros componentes mecánicos.</rdfs:comment>
        <rdfs:comment xml:lang="en">The turbine component that houses the generator and other mechanical components.</rdfs:comment>
        <rdfs:label xml:lang="en">Nacelle</rdfs:label>
        <rdfs:label xml:lang="es">Nacelle</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Observation -->


    <owl:Class rdf:about="https://w3id.org/optimar#Observation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/optimar#madeBySensor"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/optimar#Sensor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">El resultado de registrar un fenómeno o condición, normalmente a través de un sensor o sistema de monitorización.</rdfs:comment>
        <rdfs:comment xml:lang="en">The result of recording a phenomenon or condition, usually through a sensor or monitoring system.</rdfs:comment>
        <rdfs:label xml:lang="es">Observación</rdfs:label>
        <rdfs:label xml:lang="en">Observation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#OperationalState -->


    <owl:Class rdf:about="https://w3id.org/optimar#OperationalState">
        <rdfs:comment xml:lang="es">El estado operativo de un componente o sistema de la plataforma eólica.</rdfs:comment>
        <rdfs:comment xml:lang="en">The operational state of a component or system of the offshore wind power platform.</rdfs:comment>
        <rdfs:label xml:lang="es">Estado operativo</rdfs:label>
        <rdfs:label xml:lang="en">Operational state</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#ParkOwner -->


    <owl:Class rdf:about="https://w3id.org/optimar#ParkOwner">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Actor"/>
        <rdfs:comment xml:lang="es">Entidad o persona propietaria del parque eólico offshore y responsable de su operación general.</rdfs:comment>
        <rdfs:comment xml:lang="en">Entity or individual owning the offshore wind farm and responsible for its overall operation.</rdfs:comment>
        <rdfs:label xml:lang="en">Park Owner</rdfs:label>
        <rdfs:label xml:lang="es">Propietario de parque</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#PermanentMooringSystem -->


    <owl:Class rdf:about="https://w3id.org/optimar#PermanentMooringSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#MooringSystem"/>
        <owl:disjointWith rdf:resource="https://w3id.org/optimar#TemporaryMooringSystem"/>
        <rdfs:comment xml:lang="en">Mooring system designed to keep the platform in position during its whole operational life.</rdfs:comment>
        <rdfs:comment xml:lang="es">Sistema de amarre diseñado para mantener la plataforma en posición durante toda su vida operativa.</rdfs:comment>
        <rdfs:label xml:lang="en">Permanent Mooring System</rdfs:label>
        <rdfs:label xml:lang="es">Sistema de amarre permanente</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#PitchAngleData -->


    <owl:Class rdf:about="https://w3id.org/optimar#PitchAngleData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Measurement"/>
        <rdfs:comment xml:lang="es">Datos del ángulo de pitch de las palas.</rdfs:comment>
        <rdfs:comment xml:lang="en">Pitch angle data of the blades.</rdfs:comment>
        <rdfs:label xml:lang="es">Datos de ángulo de pitch</rdfs:label>
        <rdfs:label xml:lang="en">Pitch Angle Data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#PitchAngleSensor -->


    <owl:Class rdf:about="https://w3id.org/optimar#PitchAngleSensor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:comment xml:lang="es">Sensor que mide el ángulo de pitch (inclinación) de las palas de la turbina.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sensor that measures the pitch angle (inclination) of the turbine blades.</rdfs:comment>
        <rdfs:label xml:lang="en">Pitch angle sensor</rdfs:label>
        <rdfs:label xml:lang="es">Sensor de ángulo de pitch</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#PitchSystem -->


    <owl:Class rdf:about="https://w3id.org/optimar#PitchSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">El sistema que ajusta el ángulo de las palas de la turbina.</rdfs:comment>
        <rdfs:comment xml:lang="en">The system that adjusts the angle of the blades of the turbine.</rdfs:comment>
        <rdfs:label xml:lang="en">Pitch System</rdfs:label>
        <rdfs:label xml:lang="es">Sistema de pitch</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#PlatformActuator -->


    <owl:Class rdf:about="https://w3id.org/optimar#PlatformActuator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Actor"/>
        <rdfs:comment xml:lang="es">Encargado de realizar ajustes sobre la plataforma, como ajustes mecánicos o hidráulicos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Responsible for making adjustments on the platform, such as mechanical or hydraulic adjustments.</rdfs:comment>
        <rdfs:label xml:lang="es">Actuador de plataforma</rdfs:label>
        <rdfs:label xml:lang="en">Platform Actuator</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#PowerData -->


    <owl:Class rdf:about="https://w3id.org/optimar#PowerData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#ElectricalData"/>
        <rdfs:comment xml:lang="en">Active or reactive power data.</rdfs:comment>
        <rdfs:comment xml:lang="es">Datos de potencia activa o reactiva.</rdfs:comment>
        <rdfs:label xml:lang="es">Datos de potencia</rdfs:label>
        <rdfs:label xml:lang="en">Power Data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#ReactivePowerSensor -->


    <owl:Class rdf:about="https://w3id.org/optimar#ReactivePowerSensor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#ElectricalSensor"/>
        <rdfs:comment xml:lang="es">Sensor que mide la potencia reactiva del sistema eléctrico.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sensor that measures the reactive power of the electrical system.</rdfs:comment>
        <rdfs:label xml:lang="en">Reactive power sensor</rdfs:label>
        <rdfs:label xml:lang="es">Sensor de potencia reactiva</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Role -->


    <owl:Class rdf:about="https://w3id.org/optimar#Role">
        <rdfs:comment xml:lang="es">Los roles de los actores que gestionan, operan o mantienen la plataforma eólica.</rdfs:comment>
        <rdfs:comment xml:lang="en">The roles of the actors that manage, operate or maintain the offshore wind power platform.</rdfs:comment>
        <rdfs:label xml:lang="es">Rol</rdfs:label>
        <rdfs:label xml:lang="en">Role</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#RotationalSpeedSensor -->


    <owl:Class rdf:about="https://w3id.org/optimar#RotationalSpeedSensor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/optimar#isInstalledIn"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/optimar#Gearbox"/>
                            <rdf:Description rdf:about="https://w3id.org/optimar#Generator"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Sensor instalado en la caja de cambios o el generador que mide la velocidad rotacional del eje de transmisión.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sensor installed in the gearbox or the generator that measures the rotational speed of the drivetrain shaft.</rdfs:comment>
        <rdfs:label xml:lang="en">Rotational speed sensor</rdfs:label>
        <rdfs:label xml:lang="es">Sensor de velocidad rotacional</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#RotorAngleData -->


    <owl:Class rdf:about="https://w3id.org/optimar#RotorAngleData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#RotorData"/>
        <rdfs:comment xml:lang="es">Datos de ángulo de posición del rotor.</rdfs:comment>
        <rdfs:comment xml:lang="en">Rotor position angle data.</rdfs:comment>
        <rdfs:label xml:lang="es">Datos de ángulo de rotor</rdfs:label>
        <rdfs:label xml:lang="en">Rotor angle data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#RotorAngleSensor -->


    <owl:Class rdf:about="https://w3id.org/optimar#RotorAngleSensor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#RotorSensor"/>
        <rdfs:comment xml:lang="es">Sensor que mide el ángulo de posición del rotor.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sensor that measures the rotor position angle.</rdfs:comment>
        <rdfs:label xml:lang="en">Rotor angle sensor</rdfs:label>
        <rdfs:label xml:lang="es">Sensor de ángulo de rotor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#RotorData -->


    <owl:Class rdf:about="https://w3id.org/optimar#RotorData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Measurement"/>
        <rdfs:comment xml:lang="es">Datos de parámetros del rotor.</rdfs:comment>
        <rdfs:comment xml:lang="en">Rotor parameter data.</rdfs:comment>
        <rdfs:label xml:lang="es">Datos de rotor</rdfs:label>
        <rdfs:label xml:lang="en">Rotor Data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#RotorSensor -->


    <owl:Class rdf:about="https://w3id.org/optimar#RotorSensor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:comment xml:lang="es">Sensor que mide parámetros relacionados con el rotor de la turbina.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sensor that measures parameters related to the turbine rotor.</rdfs:comment>
        <rdfs:label xml:lang="en">Rotor sensor</rdfs:label>
        <rdfs:label xml:lang="es">Sensor de rotor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#RotorSpeedData -->


    <owl:Class rdf:about="https://w3id.org/optimar#RotorSpeedData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#RotorData"/>
        <rdfs:comment xml:lang="es">Datos de velocidad de rotación del rotor (RPM).</rdfs:comment>
        <rdfs:comment xml:lang="en">Rotor rotation speed data (RPM).</rdfs:comment>
        <rdfs:label xml:lang="es">Datos de velocidad de rotor</rdfs:label>
        <rdfs:label xml:lang="en">Rotor speed data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#RotorSpeedSensor -->


    <owl:Class rdf:about="https://w3id.org/optimar#RotorSpeedSensor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#RotorSensor"/>
        <rdfs:comment xml:lang="es">Sensor que mide las revoluciones por minuto (RPM) del rotor.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sensor that measures the rotor revolutions per minute (RPM).</rdfs:comment>
        <rdfs:label xml:lang="en">Rotor speed sensor</rdfs:label>
        <rdfs:label xml:lang="es">Sensor de velocidad de rotor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Seabed -->


    <owl:Class rdf:about="https://w3id.org/optimar#Seabed">
        <rdfs:comment xml:lang="es">Fondo marino del emplazamiento de la plataforma, caracterizado por su composición, espesor sedimentario e inclinación.</rdfs:comment>
        <rdfs:comment xml:lang="en">Seabed of the platform site, characterised by its soil composition, sediment thickness and inclination.</rdfs:comment>
        <rdfs:label xml:lang="es">Fondo marino</rdfs:label>
        <rdfs:label xml:lang="en">Seabed</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Sensor -->


    <owl:Class rdf:about="https://w3id.org/optimar#Sensor">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:comment xml:lang="en">A device that measures or monitors parameters of the wind platform, such as wind, corrosion, vibrations, etc.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un dispositivo que mide o monitorea parámetros de la plataforma eólica, como viento, corrosión, vibraciones, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">Sensor</rdfs:label>
        <rdfs:label xml:lang="es">Sensor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#StressData -->


    <owl:Class rdf:about="https://w3id.org/optimar#StressData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Measurement"/>
        <rdfs:comment xml:lang="es">Datos de tensión medidos por un sensor.</rdfs:comment>
        <rdfs:comment xml:lang="en">Stress data measured by a sensor.</rdfs:comment>
        <rdfs:label xml:lang="es">Datos de tensión</rdfs:label>
        <rdfs:label xml:lang="en">Stress Data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#StructuralCamera -->


    <owl:Class rdf:about="https://w3id.org/optimar#StructuralCamera">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:comment xml:lang="en">Camera dedicated to visual inspection of the structural condition of the platform.</rdfs:comment>
        <rdfs:comment xml:lang="es">Cámara dedicada a la inspección visual del estado estructural de la plataforma.</rdfs:comment>
        <rdfs:label xml:lang="es">Cámara estructural</rdfs:label>
        <rdfs:label xml:lang="en">Structural Camera</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#StructuralComponent -->


    <owl:Class rdf:about="https://w3id.org/optimar#StructuralComponent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/optimar#Base"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#FloatingSubstructure"/>
                    <rdf:Description rdf:about="https://w3id.org/optimar#MooringSystem"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Los componentes estructurales que componen la infraestructura básica de la plataforma eólica.</rdfs:comment>
        <rdfs:comment xml:lang="en">The structural components that make up the basic infrastructure of the wind platform.</rdfs:comment>
        <rdfs:label xml:lang="es">Componentes estructurales</rdfs:label>
        <rdfs:label xml:lang="en">Structural Components</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#StructuralInstability -->


    <owl:Class rdf:about="https://w3id.org/optimar#StructuralInstability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Failure"/>
        <rdfs:comment xml:lang="en">Failure that compromises the structural stability of the floating platform.</rdfs:comment>
        <rdfs:comment xml:lang="es">Fallo que compromete la estabilidad estructural de la plataforma flotante.</rdfs:comment>
        <rdfs:label xml:lang="es">Inestabilidad estructural</rdfs:label>
        <rdfs:label xml:lang="en">Structural Instability</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#SubstructureMember -->


    <owl:Class rdf:about="https://w3id.org/optimar#SubstructureMember">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:comment xml:lang="es">Elemento estructural que forma parte de una subestructura flotante (columnas, placas de arfada, riostras, etc.).</rdfs:comment>
        <rdfs:comment xml:lang="en">Structural element that is part of a floating substructure (columns, heave plates, braces, etc.).</rdfs:comment>
        <rdfs:label xml:lang="es">Miembro de la subestructura</rdfs:label>
        <rdfs:label xml:lang="en">Substructure Member</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#SuctionEmbeddedPlateAnchor -->


    <owl:Class rdf:about="https://w3id.org/optimar#SuctionEmbeddedPlateAnchor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Anchor"/>
        <rdfs:comment xml:lang="es">Ancla de placa instalada mediante un pilote de succión que se recupera tras la instalación.</rdfs:comment>
        <rdfs:comment xml:lang="en">Plate anchor installed by means of a suction follower that is retrieved after installation.</rdfs:comment>
        <rdfs:label xml:lang="es">Ancla de placa embebida por succión (SEPLA)</rdfs:label>
        <rdfs:label xml:lang="en">Suction Embedded Plate Anchor (SEPLA)</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#SuctionPileAnchor -->


    <owl:Class rdf:about="https://w3id.org/optimar#SuctionPileAnchor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Anchor"/>
        <rdfs:comment xml:lang="es">Cilindro abierto por su base que se instala en el fondo marino mediante diferencia de presión (succión).</rdfs:comment>
        <rdfs:comment xml:lang="en">Cylinder open at its base that is installed into the seabed by pressure difference (suction).</rdfs:comment>
        <rdfs:label xml:lang="es">Pilote de succión</rdfs:label>
        <rdfs:label xml:lang="en">Suction Pile Anchor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#Task -->


    <owl:Class rdf:about="https://w3id.org/optimar#Task">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment xml:lang="en">A general task related to the operation, monitoring, or maintenance of the wind platform.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una tarea general relacionada con la operación, supervisión o mantenimiento de la plataforma eólica.</rdfs:comment>
        <rdfs:label xml:lang="es">Tarea</rdfs:label>
        <rdfs:label xml:lang="en">Task</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#TautLegMooringSystem -->


    <owl:Class rdf:about="https://w3id.org/optimar#TautLegMooringSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#MooringSystem"/>
        <rdfs:comment xml:lang="en">Mooring system with pretensioned lines that reach the seabed at an angle; the restoring force comes from the line elasticity.</rdfs:comment>
        <rdfs:comment xml:lang="es">Sistema de amarre con líneas pretensadas que llegan al fondo con un ángulo; la fuerza de restauración procede de la elasticidad de las líneas.</rdfs:comment>
        <rdfs:label xml:lang="es">Sistema de amarre tenso (taut-leg)</rdfs:label>
        <rdfs:label xml:lang="en">Taut-Leg Mooring System</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#TechnicalRole -->


    <owl:Class rdf:about="https://w3id.org/optimar#TechnicalRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Role"/>
        <rdfs:comment xml:lang="es">Rol asociado a actividades técnicas como operación, reparación y supervisión de sistemas.</rdfs:comment>
        <rdfs:comment xml:lang="en">Role associated with technical activities such as operation, repair, and system supervision.</rdfs:comment>
        <rdfs:label xml:lang="es">Rol técnico</rdfs:label>
        <rdfs:label xml:lang="en">Technical Role</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#TemperatureData -->


    <owl:Class rdf:about="https://w3id.org/optimar#TemperatureData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Measurement"/>
        <rdfs:comment xml:lang="es">Datos de temperatura medidos por sensores.</rdfs:comment>
        <rdfs:comment xml:lang="en">Temperature data measured by sensors.</rdfs:comment>
        <rdfs:label xml:lang="es">Datos de temperatura</rdfs:label>
        <rdfs:label xml:lang="en">Temperature Data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#TemperatureSensor -->


    <owl:Class rdf:about="https://w3id.org/optimar#TemperatureSensor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#Sensor"/>
        <rdfs:comment xml:lang="es">Sensor que mide la temperatura de componentes o del ambiente.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sensor that measures the temperature of components or the environment.</rdfs:comment>
        <rdfs:label xml:lang="es">Sensor de temperatura</rdfs:label>
        <rdfs:label xml:lang="en">Temperature sensor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#TemporaryMooringSystem -->


    <owl:Class rdf:about="https://w3id.org/optimar#TemporaryMooringSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#MooringSystem"/>
        <rdfs:comment xml:lang="en">Mooring system used for a limited period (e.g. installation, towing or maintenance).</rdfs:comment>
        <rdfs:comment xml:lang="es">Sistema de amarre utilizado durante un periodo limitado (p. ej. instalación, remolque o mantenimiento).</rdfs:comment>
        <rdfs:label xml:lang="es">Sistema de amarre temporal</rdfs:label>
        <rdfs:label xml:lang="en">Temporary Mooring System</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/optimar#TensionLegMooringSystem -->


    <owl:Class rdf:about="https://w3id.org/optimar#TensionLegMooringSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/optimar#MooringSystem"/>
        <rdfs:comment xml:lang="en">Mooring system with vertical tendons tensioned by the excess buoyancy of the platform.</rdfs:comment>
        <rdfs:comment xml:lang="es">Sistema de amarre con tendones verticales tensionados por el exceso de flotabilidad de la plataforma.</rdfs:comment>
        <rdfs:label xml:lang="es">Sistema de amarre de patas tensionadas (TLP)</rdfs:label>
