        <rdfs:comment xml:lang="en">Relates a component with the required maintenance tasks.</rdfs:comment>
        <rdfs:label xml:lang="es">Requiere mantenimiento</rdfs:label>
        <rdfs:label xml:lang="en">Requires maintenance</rdfs:label>
    </owl:ObjectProperty>
    


