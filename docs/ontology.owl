        <rdfs:comment xml:lang="en">Indicates the type of data measured by a sensor.</rdfs:comment>
        <rdfs:label xml:lang="en">Measures</rdfs:label>
        <rdfs:label xml:lang="es">Mide</rdfs:label>
    </owl:ObjectProperty>
    


