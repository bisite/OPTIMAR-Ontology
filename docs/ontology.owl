        <rdfs:comment xml:lang="es">Indica que un componente tiene un sensor instalado.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a component has a sensor installed.</rdfs:comment>
        <rdfs:label xml:lang="en">Has installed</rdfs:label>
        <rdfs:label xml:lang="es">Tiene instalado</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasOperationalState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasOperationalState">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#OperationalState"/>
        <rdfs:comment xml:lang="es">Relaciona un componente con su estado operativo actual.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a component with its current operational state.</rdfs:comment>
        <rdfs:label xml:lang="en">Has operational state</rdfs:label>
        <rdfs:label xml:lang="es">Tiene estado operativo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasPlatform -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasPlatform">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#WindFarm"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#WindPowerPlatform"/>
        <rdfs:comment xml:lang="es">Indica la plataforma eólica asociada a un parque eólico.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates the wind power platform associated with a wind farm.</rdfs:comment>
        <rdfs:label xml:lang="en">Has platform</rdfs:label>
        <rdfs:label xml:lang="es">Tiene plataforma</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasRole -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasRole">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#Actor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Role"/>
        <rdfs:comment xml:lang="es">Indica el rol que desempeña un actor dentro del sistema.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates the role that an actor performs within the system.</rdfs:comment>
        <rdfs:label xml:lang="en">Has role</rdfs:label>
        <rdfs:label xml:lang="es">Tiene rol</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/optimar#hasTurbine -->


    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#hasTurbine">
        <rdfs:domain rdf:resource="https://w3id.org/optimar#WindPowerPlatform"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#Turbine"/>
