    <owl:ObjectProperty rdf:about="https://w3id.org/optimar#measuresPitchAngle">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/optimar#measures"/>
        <rdfs:domain rdf:resource="https://w3id.org/optimar#PitchAngleSensor"/>
        <rdfs:range rdf:resource="https://w3id.org/optimar#PitchAngleData"/>
