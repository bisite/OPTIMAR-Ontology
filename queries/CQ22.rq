# CQ22 [Sensing & failures] What electrical parameters are monitored for the generator, and what are their latest values?
PREFIX optimar: <https://w3id.org/optimar#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT ?sensor ?dataType ?value ?unit WHERE {
  ?generator a optimar:Generator ; optimar:electricalParameterMonitoredBy ?sensor .
  ?obs optimar:madeBySensor ?sensor ; sosa:hasResult ?data .
  ?data a ?dataType ; optimar:value ?value ; optimar:unit ?unit .
}
