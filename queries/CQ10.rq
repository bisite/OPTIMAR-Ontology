# CQ10 [Substructure & mooring] What are the relevant properties of the seabed?
PREFIX optimar: <https://w3id.org/optimar#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT ?location ?seabed ?soil ?sediment ?sedimentUnit ?inclination ?inclinationUnit WHERE {
  ?location optimar:hasSeabed ?seabed .
  OPTIONAL { ?seabed optimar:soilComposition ?soil }
  OPTIONAL { ?seabed optimar:sedimentThickness [ qudt:numericValue ?sediment ; qudt:unit ?sedimentUnit ] }
  OPTIONAL { ?seabed optimar:seabedInclination [ qudt:numericValue ?inclination ; qudt:unit ?inclinationUnit ] }
}
