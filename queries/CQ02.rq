# CQ02 [Structural components] What are the aerodynamic and mechanical properties of the blade?
PREFIX optimar: <https://w3id.org/optimar#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT ?blade ?property ?value ?unit WHERE {
  ?blade a optimar:Blade ; ?property ?v .
  VALUES ?property { optimar:externalShape optimar:length optimar:mass optimar:stiffness optimar:elasticModulus optimar:reinforcementType optimar:material }
  OPTIONAL { ?v qudt:numericValue ?n ; qudt:unit ?unit }
  BIND(COALESCE(?n, ?v) AS ?value)
} ORDER BY ?blade ?property
