##########################################################
# Environmental Conditions
##########################################################

ex:CurrentWindCondition a optimar:EnvironmentalCondition ;
    rdfs:label "Condiciones actuales Viento"@es ;
    optimar:windSpeed [ 
        a qudt:QuantityValue ; 
        qudt:numericValue "12.5"^^xsd:decimal ; 
        qudt:unit unit:M-PER-SEC 
    ] ;
    optimar:windDirection [ 
        a qudt:QuantityValue ; 
        qudt:numericValue "280"^^xsd:decimal ; 
        qudt:unit unit:DEG 
    ] ;
    optimar:temperatureMonitoredBy ex:TempSensor_Ambient .
##########################################################
# [v2.4] Roles as individuals (v2.3 used the role classes as values)
##########################################################

ex:TechnicalRole01 a optimar:TechnicalRole ;
    rdfs:label "Rol técnico de mantenimiento"@es .

ex:AnalyticalRole01 a optimar:AnalyticalRole ;
    rdfs:label "Rol analítico"@es .

ex:ManagementRole01 a optimar:ManagementRole ;
    rdfs:label "Rol de gestión"@es .

##########################################################
# [v2.4] Base, floating substructure members and site
##########################################################

ex:Base01 a optimar:Base ;
    rdfs:label "Pieza de transición 01"@es ;
    optimar:material "Acero estructural S355"@es ;
    optimar:supports ex:Tower01 ;
    optimar:isSupportedBy ex:FloatingSubstructure01 .

ex:FloatingSubstructure01
    optimar:hasMember ex:Column01, ex:Column02, ex:Column03,
                      ex:HeavePlate01, ex:HeavePlate02, ex:HeavePlate03,
                      ex:Brace01, ex:Brace02, ex:Brace03 ;
    optimar:draft [ a qudt:QuantityValue ; qudt:numericValue "20"^^xsd:decimal ; qudt:unit unit:M ] ;
    optimar:displacedVolume [ a qudt:QuantityValue ; qudt:numericValue "15000"^^xsd:decimal ; qudt:unit unit:M3 ] .

ex:Column01 a optimar:Column ; rdfs:label "Columna 01"@es ;
    optimar:diameter [ a qudt:QuantityValue ; qudt:numericValue "12.5"^^xsd:decimal ; qudt:unit unit:M ] .
ex:Column02 a optimar:Column ; rdfs:label "Columna 02"@es .
ex:Column03 a optimar:Column ; rdfs:label "Columna 03"@es .
ex:HeavePlate01 a optimar:HeavePlate ; rdfs:label "Placa de arfada 01"@es ; optimar:connectedTo ex:Column01 .
ex:HeavePlate02 a optimar:HeavePlate ; rdfs:label "Placa de arfada 02"@es ; optimar:connectedTo ex:Column02 .
ex:HeavePlate03 a optimar:HeavePlate ; rdfs:label "Placa de arfada 03"@es ; optimar:connectedTo ex:Column03 .
ex:Brace01 a optimar:Brace ; rdfs:label "Riostra 01-02"@es ; optimar:connectedTo ex:Column01, ex:Column02 .
ex:Brace02 a optimar:Brace ; rdfs:label "Riostra 02-03"@es ; optimar:connectedTo ex:Column02, ex:Column03 .
ex:Brace03 a optimar:Brace ; rdfs:label "Riostra 03-01"@es ; optimar:connectedTo ex:Column03, ex:Column01 .

ex:NorthSeaLocation
    optimar:hasSeabed ex:Seabed01 ;
    optimar:waterDepth [ a qudt:QuantityValue ; qudt:numericValue "150"^^xsd:decimal ; qudt:unit unit:M ] .

ex:Seabed01 a optimar:Seabed ;
    rdfs:label "Fondo marino del emplazamiento"@es ;
    optimar:soilComposition "Arcilla"@es ;
    optimar:sedimentThickness [ a qudt:QuantityValue ; qudt:numericValue "12"^^xsd:decimal ; qudt:unit unit:M ] ;
    optimar:seabedInclination [ a qudt:QuantityValue ; qudt:numericValue "2"^^xsd:decimal ; qudt:unit unit:DEG ] .

##########################################################
# [v2.4] Mooring system decomposition
##########################################################

ex:MooringSystem01
    optimar:numberOfMooringLines "3"^^xsd:nonNegativeInteger ;
    optimar:hasLineDistribution optimar:EvenlyDistributed ;
    optimar:hasMooringLine ex:MooringLine01, ex:MooringLine02, ex:MooringLine03 ;
    optimar:hasAnchor ex:Anchor01, ex:Anchor02, ex:Anchor03 ;
    optimar:hasMooringComponent ex:Fairlead01, ex:Fairlead02, ex:Fairlead03, ex:Connector01, ex:Tensioner01 .

ex:MooringLine01 a optimar:MooringLine ; rdfs:label "Línea de amarre 01"@es ;
    optimar:material "Cadena de acero R4"@es ;
    optimar:length [ a qudt:QuantityValue ; qudt:numericValue "650"^^xsd:decimal ; qudt:unit unit:M ] ;
    optimar:lineTension [ a qudt:QuantityValue ; qudt:numericValue "1200"^^xsd:decimal ; qudt:unit unit:KiloN ] ;
    optimar:connectedTo ex:Fairlead01, ex:Connector01 .
ex:MooringLine02 a optimar:MooringLine ; rdfs:label "Línea de amarre 02"@es ;
    optimar:connectedTo ex:Fairlead02, ex:Anchor02 ;
    optimar:affectedBy ex:MooringLineFatigue02 .
ex:MooringLine03 a optimar:MooringLine ; rdfs:label "Línea de amarre 03"@es ;
    optimar:connectedTo ex:Fairlead03, ex:Anchor03 .

ex:Fairlead01 a optimar:Fairlead ; rdfs:label "Fairlead 01"@es ; optimar:connectedTo ex:Column01 .
ex:Fairlead02 a optimar:Fairlead ; rdfs:label "Fairlead 02"@es ; optimar:connectedTo ex:Column02 .
ex:Fairlead03 a optimar:Fairlead ; rdfs:label "Fairlead 03"@es ; optimar:connectedTo ex:Column03 .
ex:Connector01 a optimar:MooringConnector ; rdfs:label "Grillete línea 01"@es ; optimar:connectedTo ex:Anchor01 .
ex:Tensioner01 a optimar:Tensioner ; rdfs:label "Tensor línea 01"@es ; optimar:connectedTo ex:MooringLine01 .

ex:Anchor01 a optimar:DragEmbedmentAnchor ; rdfs:label "Ancla 01 (DEA)"@es ;
    optimar:anchoredIn ex:Seabed01 ;
    optimar:mass [ a qudt:QuantityValue ; qudt:numericValue "25000"^^xsd:decimal ; qudt:unit unit:KiloGM ] ;
    optimar:anchorLoad [ a qudt:QuantityValue ; qudt:numericValue "3500"^^xsd:decimal ; qudt:unit unit:KiloN ] ;
    optimar:transportLoad [ a qudt:QuantityValue ; qudt:numericValue "250"^^xsd:decimal ; qudt:unit unit:KiloN ] .
ex:Anchor02 a optimar:DragEmbedmentAnchor ; rdfs:label "Ancla 02 (DEA)"@es ; optimar:anchoredIn ex:Seabed01 .
ex:Anchor03 a optimar:SuctionPileAnchor ; rdfs:label "Ancla 03 (pilote de succión)"@es ; optimar:anchoredIn ex:Seabed01 .

ex:MooringLineFatigue02 a optimar:MaterialFatigue ;
    rdfs:label "Fatiga en la línea de amarre 02"@es ;
    optimar:severity "low"^^xsd:string ;
    optimar:detectionDateTime "2026-02-03T09:00:00Z"^^xsd:dateTime .

##########################################################
# [v2.4] Additional mechanical properties
##########################################################

ex:Blade01
    optimar:mass [ a qudt:QuantityValue ; qudt:numericValue "65000"^^xsd:decimal ; qudt:unit unit:KiloGM ] ;
    optimar:stiffness [ a qudt:QuantityValue ; qudt:numericValue "1.8E10"^^xsd:decimal ; qudt:unit unit:N-M2 ] ;
    optimar:elasticModulus [ a qudt:QuantityValue ; qudt:numericValue "135"^^xsd:decimal ; qudt:unit unit:GigaPA ] ;
    optimar:reinforcementType "Largueros de fibra de carbono y almas de fibra de vidrio"@es .

ex:Hub01
    optimar:diameter [ a qudt:QuantityValue ; qudt:numericValue "5"^^xsd:decimal ; qudt:unit unit:M ] ;
    optimar:mass [ a qudt:QuantityValue ; qudt:numericValue "190000"^^xsd:decimal ; qudt:unit unit:KiloGM ] ;
    optimar:momentOfInertia [ a qudt:QuantityValue ; qudt:numericValue "9.8E5"^^xsd:decimal ; qudt:unit unit:KiloGM-M2 ] .

ex:Nacelle01
    optimar:mass [ a qudt:QuantityValue ; qudt:numericValue "630000"^^xsd:decimal ; qudt:unit unit:KiloGM ] .

ex:Generator01
    optimar:rotationSpeed [ a qudt:QuantityValue ; qudt:numericValue "1800"^^xsd:decimal ; qudt:unit unit:REV-PER-MIN ] .

ex:Tower01
    optimar:diameter [ a qudt:QuantityValue ; qudt:numericValue "10"^^xsd:decimal ; qudt:unit unit:M ] ;
    optimar:thickness [ a qudt:QuantityValue ; qudt:numericValue "80"^^xsd:decimal ; qudt:unit unit:MilliM ] .

##########################################################
# [v2.4] Sensor acquisition metadata (Table 5 of the requirements)
##########################################################

ex:CorrosionCam01 optimar:samplingFrequency [ a qudt:QuantityValue ; qudt:numericValue "1"^^xsd:decimal ; qudt:unit unit:PER-MIN ] ;
    optimar:dataFormat "JPG" ; optimar:isInstalledIn ex:Hub01 .
ex:CorrosionCam02 optimar:samplingFrequency [ a qudt:QuantityValue ; qudt:numericValue "1"^^xsd:decimal ; qudt:unit unit:PER-MIN ] ;
    optimar:dataFormat "JPG" ; optimar:isInstalledIn ex:FloatingSubstructure01 .
ex:Anemometer01 optimar:samplingFrequency [ a qudt:QuantityValue ; qudt:numericValue "1"^^xsd:decimal ; qudt:unit unit:PER-MIN ] ;
    optimar:dataFormat "CSV" ; optimar:isInstalledIn ex:Nacelle01 .
ex:VibrationSensor01 optimar:dataFormat "CSV" ; optimar:isInstalledIn ex:Tower01 ; optimar:monitors ex:Tower01 .
ex:VibrationSensor02 optimar:dataFormat "CSV" ; optimar:isInstalledIn ex:Nacelle01 ; optimar:monitors ex:Nacelle01 .
ex:GaugeSystem01 optimar:samplingFrequency [ a qudt:QuantityValue ; qudt:numericValue "50"^^xsd:decimal ; qudt:unit unit:HZ ] ;
    optimar:dataFormat "TXT" ; optimar:isInstalledIn ex:Tower01 ; optimar:monitors ex:Tower01 .
ex:TempSensor_Generator optimar:samplingFrequency [ a qudt:QuantityValue ; qudt:numericValue "0.5"^^xsd:decimal ; qudt:unit unit:PER-MIN ] ;
    optimar:dataFormat "Modbus" ; optimar:measures ex:GeneratorTempData01 .
ex:TempSensor_Gearbox optimar:samplingFrequency [ a qudt:QuantityValue ; qudt:numericValue "0.5"^^xsd:decimal ; qudt:unit unit:PER-MIN ] ;
    optimar:dataFormat "Modbus" ; optimar:measures ex:GearboxTempData01 .
ex:PowerSensor01 optimar:samplingFrequency [ a qudt:QuantityValue ; qudt:numericValue "0.1"^^xsd:decimal ; qudt:unit unit:PER-MIN ] ;
    optimar:dataFormat "JSON" ; optimar:measures ex:ActivePowerData01 .
ex:ReactivePowerSensor01 optimar:dataFormat "JSON" ; optimar:measures ex:ReactivePowerData01 .
ex:VoltageSensor01 optimar:dataFormat "JSON" ; optimar:measures ex:VoltageData01 .
ex:CurrentSensor01 optimar:dataFormat "JSON" ; optimar:measures ex:CurrentData01 .
ex:FreqSensor01 optimar:dataFormat "JSON" ; optimar:measures ex:FrequencyData01 .
ex:YawSensor01 optimar:samplingFrequency [ a qudt:QuantityValue ; qudt:numericValue "0.1"^^xsd:decimal ; qudt:unit unit:PER-MIN ] ;
    optimar:dataFormat "JSON" .

ex:ISUM01 a optimar:ISUMSystem ;
    rdfs:label "Sistema iSUM - Subestructura flotante"@es ;
    optimar:isInstalledIn ex:FloatingSubstructure01 ;
    optimar:monitors ex:FloatingSubstructure01 ;
    optimar:samplingFrequency [ a qudt:QuantityValue ; qudt:numericValue "1"^^xsd:decimal ; qudt:unit unit:PER-DAY ] ;
    optimar:dataFormat "binary (float32)" .

ex:StructuralCam01 a optimar:StructuralCamera ;
    rdfs:label "Cámara estructural - Torre"@es ;
    optimar:monitors ex:Tower01 ;
    optimar:dataFormat "MP4" .

##########################################################
# [v2.4] Predictive maintenance chain (use case 2):
# observation -> failure event -> failure -> maintenance
##########################################################

ex:GearboxVibrationSensor01 a optimar:DynamicMonitor ;
    rdfs:label "Acelerómetro del rodamiento principal - Gearbox"@es ;
    optimar:isInstalledIn ex:Gearbox01 ;
    optimar:monitors ex:Gearbox01 ;
    optimar:measuresVibration ex:GearboxVibrationData01 ;
    optimar:samplingFrequency [ a qudt:QuantityValue ; qudt:numericValue "25"^^xsd:decimal ; qudt:unit unit:HZ ] ;
    optimar:dataFormat "CSV" .

ex:GearboxVibrationData01 a optimar:VibrationData ;
    rdfs:label "Nivel de vibración elevado - rodamiento Gearbox"@es ;
    optimar:vibrationLevel [ a qudt:QuantityValue ; qudt:numericValue "8.5"^^xsd:decimal ; qudt:unit unit:MilliM-PER-SEC ] ;
    optimar:dateTime "2026-01-30T14:23:00Z"^^xsd:dateTime .

ex:Observation_Vibration_Gearbox a optimar:Observation ;
    rdfs:label "Observación de vibración del rodamiento de la Gearbox"@es ;
    optimar:madeBySensor ex:GearboxVibrationSensor01 ;
    sosa:hasFeatureOfInterest ex:Gearbox01 ;
    sosa:hasResult ex:GearboxVibrationData01 ;
    sosa:resultTime "2026-01-30T14:23:00Z"^^xsd:dateTime .

ex:GearboxBearingFatigue a optimar:MaterialFatigue ;
    rdfs:label "Fatiga del rodamiento principal de la Gearbox"@es ;
    optimar:affects ex:Gearbox01 ;
    optimar:severity "high"^^xsd:string ;
    optimar:detectionDateTime "2026-01-30T14:23:00Z"^^xsd:dateTime .

ex:GearboxFailureEvent01 a optimar:FailureEvent ;
    rdfs:label "Evento de fallo - rodamiento de la Gearbox"@es ;
    optimar:causedBy ex:GearboxBearingFatigue ;
    optimar:detectedBy ex:GearboxVibrationSensor01 ;
    optimar:failureObservation ex:Observation_Vibration_Gearbox ;
    optimar:relatedToComponent ex:Gearbox01 ;
    optimar:startDateTime "2026-01-30T14:23:00Z"^^xsd:dateTime .

ex:GearboxBearingReplacement01 a optimar:Maintenance ;
    rdfs:label "Sustitución del rodamiento principal de la Gearbox"@es ;
    optimar:performedBy ex:Operator01 ;
    optimar:addressesFailure ex:GearboxBearingFatigue ;
    optimar:triggeredBy ex:GearboxFailureEvent01 ;
    optimar:startDateTime "2026-01-30T16:00:00Z"^^xsd:dateTime ;
    optimar:endDateTime "2026-01-30T18:30:00Z"^^xsd:dateTime ;
    optimar:duration [ a qudt:QuantityValue ; qudt:numericValue "2.5"^^xsd:decimal ; qudt:unit unit:HR ] .

ex:Gearbox01 optimar:requiresMaintenance ex:GearboxBearingReplacement01 .
ex:Analyst01 optimar:analyzes ex:GearboxVibrationData01, ex:GearboxBearingFatigue .

##########################################################
# [v2.4] SOSA alignment of the existing observations:
# feature of interest and result time
##########################################################

ex:Observation_Vibration_Tower sosa:hasFeatureOfInterest ex:Tower01 ; sosa:resultTime "2026-01-19T10:30:00Z"^^xsd:dateTime .
ex:Observation_Vibration_Nacelle sosa:hasFeatureOfInterest ex:Nacelle01 ; sosa:resultTime "2026-01-19T10:30:00Z"^^xsd:dateTime .
ex:Observation_Stress_Tower sosa:hasFeatureOfInterest ex:Tower01 ; sosa:resultTime "2026-01-19T10:30:00Z"^^xsd:dateTime .
ex:Observation_Temp_Generator sosa:hasFeatureOfInterest ex:Generator01 ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_Temp_Gearbox sosa:hasFeatureOfInterest ex:Gearbox01 ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_Temp_Transformer sosa:hasFeatureOfInterest ex:Transformer01 ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_Temp_Ambient sosa:hasFeatureOfInterest ex:CurrentWindCondition ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_ActivePower sosa:hasFeatureOfInterest ex:Generator01 ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_ReactivePower sosa:hasFeatureOfInterest ex:Generator01 ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_Voltage sosa:hasFeatureOfInterest ex:Generator01 ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_Current sosa:hasFeatureOfInterest ex:Generator01 ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_Frequency sosa:hasFeatureOfInterest ex:Generator01 ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_Torque sosa:hasFeatureOfInterest ex:Generator01 ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_RotorSpeed sosa:hasFeatureOfInterest ex:Hub01 ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_RotorAngle sosa:hasFeatureOfInterest ex:Hub01 ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_YawAngle sosa:hasFeatureOfInterest ex:Nacelle01 ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_PitchAngle_01 sosa:hasFeatureOfInterest ex:Blade01 ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_PitchAngle_02 sosa:hasFeatureOfInterest ex:Blade02 ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_PitchAngle_03 sosa:hasFeatureOfInterest ex:Blade03 ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_WindSpeed sosa:hasFeatureOfInterest ex:CurrentWindCondition ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_WindDirection sosa:hasFeatureOfInterest ex:CurrentWindCondition ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_ApparentPower sosa:hasFeatureOfInterest ex:Inverter01 ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
ex:Observation_RotationalSpeed_Gearbox sosa:hasFeatureOfInterest ex:Gearbox01 ; sosa:resultTime "2026-01-19T12:00:00Z"^^xsd:dateTime .
